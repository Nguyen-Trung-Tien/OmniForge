# Auto detect text files and perform LF normalization
* text=auto eol=crlf

# Source code files
*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.sln text eol=crlf

# Script files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf

# Documentation & Config
*.md text eol=crlf
*.json text eol=crlf
*.xml text eol=crlf
*.manifest text eol=crlf
*.txt text eol=crlf
.gitignore text eol=crlf
.gitattributes text eol=crlf

# Binary assets
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.dll binary
*.exe binary
*.pri binary
*.xbf binary

