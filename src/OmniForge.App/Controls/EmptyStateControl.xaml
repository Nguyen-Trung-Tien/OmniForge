<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OmniForge.App.Controls.EmptyStateControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="10"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{x:Bind IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
        <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay}"
                  FontSize="36"
                  HorizontalAlignment="Center"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                   HorizontalAlignment="Center" />
        <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   MaxWidth="360"
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>

