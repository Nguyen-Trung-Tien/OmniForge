<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OmniForge.App.Controls.StatusFooterControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Style="{StaticResource FluentCardBorderStyle}" Padding="14,10">
        <StackPanel Spacing="8">
            <!-- Active Task Progress Banner with Percentage & Cancel Button -->
            <Grid ColumnSpacing="12"
                  Visibility="{x:Bind IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressRing Grid.Column="0"
                              Width="16"
                              Height="16"
                              IsActive="{x:Bind IsBusy, Mode=OneWay}"
                              VerticalAlignment="Center" />

                <ProgressBar Grid.Column="1"
                             IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                             Value="{x:Bind ProgressPercent, Mode=OneWay}"
                             Maximum="100"
                             VerticalAlignment="Center" />

                <Border Grid.Column="2"
                        Style="{StaticResource StatusBadgeBorderStyle}"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind IsDeterminate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{x:Bind ProgressPercentText, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Border>

                <Button Grid.Column="3"
                        Padding="10,4"
                        FontSize="12"
                        ToolTipService.ToolTip="Cancel the currently running task (Esc)"
                        Click="CancelTaskButton_Click"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock Text="Cancel Task" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" />
                    </Button.KeyboardAccelerators>
                </Button>
            </Grid>

            <!-- Status Line & Execution Duration Badge -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0"
                          Glyph="&#xE946;"
                          FontSize="12"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                <TextBlock Grid.Column="1"
                           Text="{x:Bind StatusMessage, Mode=OneWay}"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <Border Grid.Column="2"
                        Style="{StaticResource StatusBadgeBorderStyle}"
                        Visibility="{x:Bind HasDuration, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE916;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind DurationText, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
