<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="OmniForge.App.Controls.ToolHeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="10">
        <StackPanel Spacing="4">
            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Action Confirmation Prompt Banner (Before Destructive / Batch Execution) -->
        <InfoBar IsOpen="{x:Bind IsConfirmationOpen, Mode=TwoWay}"
                 Severity="Warning"
                 IsClosable="True"
                 Title="{x:Bind ConfirmationTitle, Mode=OneWay}"
                 Message="{x:Bind ConfirmationMessage, Mode=OneWay}">
            <InfoBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,12">
                    <Button Content="{Binding Source={StaticResource Loc}, Path=[Control_ToolHeader_ConfirmAndExecute]}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="ConfirmActionButton_Click" />
                    <Button Content="{Binding Source={StaticResource Loc}, Path=[Control_ToolHeader_Cancel]}"
                            Click="DismissConfirmationButton_Click" />
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>

        <!-- Action Completed Confirmation Banner -->
        <InfoBar IsOpen="{x:Bind HasSuccessMessage, Mode=TwoWay}"
                 Severity="Success"
                 IsClosable="True"
                 Title="{Binding Source={StaticResource Loc}, Path=[Control_ToolHeader_ActionCompleted]}"
                 Message="{x:Bind SuccessMessage, Mode=OneWay}" />

        <!-- Error / Fault Isolation Banner -->
        <InfoBar IsOpen="{x:Bind HasError, Mode=TwoWay}"
                 Severity="Error"
                 IsClosable="True"
                 Message="{x:Bind ErrorMessage, Mode=OneWay}" />
    </StackPanel>
</UserControl>
