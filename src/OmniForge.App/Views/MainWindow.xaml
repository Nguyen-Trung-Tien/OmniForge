<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="OmniForge.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:OmniForge.App.ViewModels"
    Title="{x:Bind ViewModel.AppTitle, Mode=OneWay}"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Fluent App Title Bar with MicaAlt integration -->
        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Height="32"
                  Title="{x:Bind ViewModel.AppTitle, Mode=OneWay}" />

        <!-- Main Shell Navigation with Adaptive Responsive Thresholds, AutoSuggestBox, and Fluent Design -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Auto"
                        ExpandedModeThresholdWidth="1008"
                        CompactModeThresholdWidth="680"
                        OpenPaneLength="250"
                        CompactPaneLength="48"
                        IsBackButtonVisible="Auto"
                        IsBackEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                        BackRequested="NavView_BackRequested"
                        SelectionChanged="NavView_SelectionChanged"
                        MenuItemsSource="{x:Bind ViewModel.NavigationItems, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                        IsSettingsVisible="True"
                        AlwaysShowHeader="False">

            <!-- Branded Pane Header with Vector SVG Logo & Waffle App Launcher -->
            <NavigationView.PaneHeader>
                <Grid Margin="12,12,12,10" Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Image Width="24" Height="24" VerticalAlignment="Center">
                            <Image.Source>
                                <SvgImageSource UriSource="ms-appx:///Assets/logo.svg" RasterizePixelWidth="48" RasterizePixelHeight="48" />
                            </Image.Source>
                        </Image>
                        <TextBlock Text="OmniForge"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Waffle Menu (App Launcher) -->
                    <Button Grid.Column="1"
                            ToolTipService.ToolTip="App Launcher (All Modules)"
                            AutomationProperties.Name="App Launcher"
                            Padding="6,4"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center">
                        <FontIcon Glyph="&#xED35;" FontSize="14" />
                        <Button.Flyout>
                            <Flyout x:Name="AppLauncherFlyout" Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="10" Width="260">
                                    <TextBlock Text="App Launcher" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <ListView ItemsSource="{x:Bind ViewModel.NavigationItems, Mode=OneWay}"
                                              SelectionMode="None"
                                              IsItemClickEnabled="True"
                                              ItemClick="AppLauncherItem_Click">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:NavigationItemViewModel">
                                                <StackPanel Orientation="Horizontal" Spacing="12" Padding="4,6">
                                                    <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" />
                                                        <TextBlock Text="{x:Bind Description}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </NavigationView.PaneHeader>

            <!-- Real-time Tool Search and Auto-Suggest Box -->
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="SearchBox"
                                PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                                QueryIcon="Find"
                                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ItemsSource="{x:Bind ViewModel.SearchSuggestions, Mode=OneWay}"
                                QuerySubmitted="SearchBox_QuerySubmitted"
                                SuggestionChosen="SearchBox_SuggestionChosen" />
            </NavigationView.AutoSuggestBox>

            <NavigationView.MenuItemTemplate>
                <DataTemplate x:DataType="vm:NavigationItemViewModel">
                    <NavigationViewItem Content="{x:Bind Title, Mode=OneWay}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="{x:Bind Description, Mode=OneWay}">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="{x:Bind IconGlyph}" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </DataTemplate>
            </NavigationView.MenuItemTemplate>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Module Fault Isolation Banner -->
                <InfoBar Grid.Row="0"
                         Margin="20,10,20,0"
                         Severity="Error"
                         Title="Module Activation Error"
                         IsOpen="{x:Bind ViewModel.HasShellError, Mode=OneWay}"
                         Message="{x:Bind ViewModel.ShellErrorMessage, Mode=OneWay}"
                         CloseButtonCommand="{x:Bind ViewModel.DismissShellErrorCommand}" />

                <!-- Dynamic Page Content Frame -->
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
