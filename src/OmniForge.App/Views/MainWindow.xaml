<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="OmniForge.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:OmniForge.App.ViewModels"
    Title="{x:Bind ViewModel.AppTitle, Mode=OneWay}"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Fluent App Title Bar with MicaAlt integration -->
        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title="{x:Bind ViewModel.AppTitle, Mode=OneWay}">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/app.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Main Shell Navigation with Left-expanded Pane, AutoSuggestBox, and Fluent Design -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsPaneOpen="True"
                        OpenPaneLength="260"
                        CompactPaneLength="48"
                        IsBackButtonVisible="Auto"
                        IsBackEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                        BackRequested="NavView_BackRequested"
                        ItemInvoked="NavView_ItemInvoked"
                        SelectionChanged="NavView_SelectionChanged"
                        MenuItemsSource="{x:Bind ViewModel.NavigationItems, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                        IsSettingsVisible="True"
                        AlwaysShowHeader="False">

            <!-- Branded Pane Header with Vector SVG Logo -->
            <NavigationView.PaneHeader>
                <Grid Margin="12,12,12,10" Height="36">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Image Width="24" Height="24" VerticalAlignment="Center">
                            <Image.Source>
                                <SvgImageSource UriSource="ms-appx:///Assets/logo.svg" RasterizePixelWidth="48" RasterizePixelHeight="48" />
                            </Image.Source>
                        </Image>
                        <TextBlock Text="OmniForge"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <!-- Real-time Tool Search and Auto-Suggest Box -->
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="SearchBox"
                                PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                                QueryIcon="Find"
                                Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ItemsSource="{x:Bind ViewModel.SearchSuggestions, Mode=OneWay}"
                                QuerySubmitted="SearchBox_QuerySubmitted"
                                SuggestionChosen="SearchBox_SuggestionChosen" />
            </NavigationView.AutoSuggestBox>

            <NavigationView.MenuItemTemplate>
                <DataTemplate x:DataType="vm:NavigationItemViewModel">
                    <NavigationViewItem Content="{x:Bind Title, Mode=OneWay}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="{x:Bind Description, Mode=OneWay}">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="{x:Bind IconGlyph}" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </DataTemplate>
            </NavigationView.MenuItemTemplate>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Module Fault Isolation Banner -->
                <InfoBar Grid.Row="0"
                         Margin="36,12,36,0"
                         Severity="Error"
                         Title="Module Activation Error"
                         IsOpen="{x:Bind ViewModel.HasShellError, Mode=OneWay}"
                         Message="{x:Bind ViewModel.ShellErrorMessage, Mode=OneWay}"
                         CloseButtonCommand="{x:Bind ViewModel.DismissShellErrorCommand}" />

                <!-- Dynamic Page Content Frame -->
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
