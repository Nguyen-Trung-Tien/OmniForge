<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OmniForge.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:OmniForge.App.Controls"
    xmlns:models="using:OmniForge.Core.Models"
    xmlns:vm="using:OmniForge.App.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer x:Name="RootScrollViewer" Style="{StaticResource PageScrollViewerStyle}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveStates">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="980" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootScrollViewer.Padding" Value="{StaticResource OmniCompactPagePadding}" />
                        <Setter Target="CurrentVersionCol1.Width" Value="0" />
                        <Setter Target="CheckUpdatesBtn.(Grid.Row)" Value="1" />
                        <Setter Target="CheckUpdatesBtn.(Grid.Column)" Value="0" />
                        <Setter Target="CheckUpdatesBtn.HorizontalAlignment" Value="Left" />
                        <Setter Target="UpdateAvailableCol1.Width" Value="0" />
                        <Setter Target="DownloadUpdateBtn.(Grid.Row)" Value="1" />
                        <Setter Target="DownloadUpdateBtn.(Grid.Column)" Value="0" />
                        <Setter Target="DownloadUpdateBtn.HorizontalAlignment" Value="Left" />
                        <Setter Target="ReadyInstallCol2.Width" Value="0" />
                        <Setter Target="InstallBtn.(Grid.Row)" Value="1" />
                        <Setter Target="InstallBtn.(Grid.Column)" Value="1" />
                        <Setter Target="InstallBtn.HorizontalAlignment" Value="Left" />
                        <Setter Target="UpdatePrefsCol1.Width" Value="0" />
                        <Setter Target="AutoCheckSwitch.(Grid.Row)" Value="1" />
                        <Setter Target="AutoCheckSwitch.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel Style="{StaticResource PageRootStackPanelStyle}">
            <controls:ToolHeaderControl
                Title="{x:Bind ViewModel.TitleText, Mode=OneWay}"
                Subtitle="{x:Bind ViewModel.SubtitleText, Mode=OneWay}" />

            <!-- Application Updates Section Card -->
            <controls:SectionCardControl
                Title="{x:Bind ViewModel.UpdatesTitle, Mode=OneWay}"
                Subtitle="{x:Bind ViewModel.UpdatesSubtitle, Mode=OneWay}"
                IconGlyph="&#xE895;">
                <StackPanel Spacing="16">
                    <!-- Current Version & Action Row -->
                    <Grid x:Name="CurrentVersionRow" ColumnSpacing="16" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="CurrentVersionCol0" Width="*" />
                            <ColumnDefinition x:Name="CurrentVersionCol1" Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.UpdatesCurrentVersionLabel, Mode=OneWay}"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <Border Style="{StaticResource StatusBadgeBorderStyle}">
                                    <TextBlock Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.LastCheckedText, Mode=OneWay}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- Check for Updates Button with embedded ProgressRing -->
                        <Button x:Name="CheckUpdatesBtn"
                                Grid.Row="0" Grid.Column="1"
                                Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                                IsEnabled="{x:Bind ViewModel.CanCheckUpdates, Mode=OneWay}"
                                VerticalAlignment="Center"
                                Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsCheckingUpdates, Mode=OneWay}"
                                              Width="16" Height="16"
                                              Visibility="{x:Bind ViewModel.IsCheckingUpdates, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Text="{x:Bind ViewModel.UpdatesCheckingText, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.IsCheckingUpdates, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Text="{x:Bind ViewModel.UpdatesCheckNowButtonText, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.IsCheckingUpdates, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Up-to-date Confirmation Indicator (Auto-dismisses in 5s) -->
                    <InfoBar IsOpen="{x:Bind ViewModel.IsUpToDate, Mode=TwoWay}"
                             Severity="Success"
                             IsClosable="True"
                             Title="{x:Bind ViewModel.UpdatesUpToDateText, Mode=OneWay}"
                             Message="{x:Bind ViewModel.LastCheckedText, Mode=OneWay}" />

                    <!-- Error Alert InfoBar -->
                    <InfoBar IsOpen="{x:Bind ViewModel.HasUpdateError, Mode=OneWay}"
                             Severity="Error"
                             IsClosable="True"
                             Message="{x:Bind ViewModel.UpdateErrorMessage, Mode=OneWay}"
                             CloseButtonCommand="{x:Bind ViewModel.DismissUpdateErrorCommand}">
                        <InfoBar.ActionButton>
                            <Button Content="{x:Bind ViewModel.UpdatesRetryButtonText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                                    Style="{ThemeResource SubtleButtonStyle}" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <!-- Update Available Notification Card -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Visibility="{x:Bind ViewModel.IsUpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="12">
                            <Grid x:Name="UpdateAvailableGrid" ColumnSpacing="12" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="UpdateAvailableCol0" Width="*" />
                                    <ColumnDefinition x:Name="UpdateAvailableCol1" Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind ViewModel.UpdatesAvailableText, Mode=OneWay}"
                                                   Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <Border Style="{StaticResource StatusBadgeBorderStyle}"
                                                Visibility="{x:Bind ViewModel.DownloadSizeText, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{x:Bind ViewModel.DownloadSizeText, Mode=OneWay}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.UpdatesAvailableDesc, Mode=OneWay}"
                                               Style="{ThemeResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <Button x:Name="DownloadUpdateBtn"
                                        Grid.Row="0" Grid.Column="1"
                                        Content="{x:Bind ViewModel.UpdatesDownloadButtonText, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.DownloadUpdateCommand}"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        VerticalAlignment="Center"
                                        Padding="16,8" />
                            </Grid>

                            <!-- Release Notes Expander -->
                            <Expander Header="{x:Bind ViewModel.UpdatesReleaseNotesLabel, Mode=OneWay}"
                                      HorizontalAlignment="Stretch"
                                      Visibility="{x:Bind ViewModel.HasReleaseNotes, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <TextBox Text="{x:Bind ViewModel.ReleaseNotesText, Mode=OneWay}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             Style="{StaticResource MonospaceCodeTextBoxStyle}"
                                             BorderThickness="0"
                                             Background="Transparent" />
                                </ScrollViewer>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!-- Downloading Progress Card -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Visibility="{x:Bind ViewModel.IsDownloadingUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.DownloadProgressText, Mode=OneWay}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.DownloadSpeedText, Mode=OneWay}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="{x:Bind ViewModel.UpdatesCancelDownloadButtonText, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.CancelDownloadCommand}"
                                        VerticalAlignment="Center" />
                            </Grid>

                            <ProgressBar Value="{x:Bind ViewModel.DownloadProgressPercentage, Mode=OneWay}"
                                         Maximum="100"
                                         Height="6"
                                         HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <!-- Ready to Install Action Card -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Visibility="{x:Bind ViewModel.IsReadyToInstall, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid x:Name="ReadyInstallGrid" ColumnSpacing="16" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition x:Name="ReadyInstallCol1" Width="*" />
                                <ColumnDefinition x:Name="ReadyInstallCol2" Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Row="0" Grid.Column="0"
                                      Glyph="&#xE73E;"
                                      FontSize="24"
                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                      VerticalAlignment="Center" />

                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.UpdatesReadyToInstallText, Mode=OneWay}"
                                           Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.UpdatesReadyToInstallDesc, Mode=OneWay}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Button x:Name="InstallBtn"
                                    Grid.Row="0" Grid.Column="2"
                                    Content="{x:Bind ViewModel.UpdatesInstallButtonText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.InstallUpdateCommand}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    VerticalAlignment="Center"
                                    Padding="16,8" />
                        </Grid>
                    </Border>

                    <!-- Update Preferences: Channel & Auto-Check -->
                    <Grid x:Name="UpdatePrefsGrid" ColumnSpacing="24" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="UpdatePrefsCol0" Width="*" />
                            <ColumnDefinition x:Name="UpdatePrefsCol1" Width="*" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Row="0" Grid.Column="0"
                                  Header="{x:Bind ViewModel.UpdatesChannelLabel, Mode=OneWay}"
                                  ItemsSource="{x:Bind ViewModel.ChannelOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedChannel, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanCheckUpdates, Mode=OneWay}"
                                  HorizontalAlignment="Stretch" />

                        <ToggleSwitch x:Name="AutoCheckSwitch"
                                      Grid.Row="0" Grid.Column="1"
                                      Header="{x:Bind ViewModel.UpdatesAutoCheckLabel, Mode=OneWay}"
                                      IsOn="{x:Bind ViewModel.AutoCheckOnStartup, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.CanCheckUpdates, Mode=OneWay}"
                                      HorizontalAlignment="Stretch" />
                    </Grid>
                </StackPanel>
            </controls:SectionCardControl>

            <!-- Language & Regional Preferences Section Card -->
            <controls:SectionCardControl
                Title="{x:Bind ViewModel.LanguageTitle, Mode=OneWay}"
                Subtitle="{x:Bind ViewModel.LanguageSubtitle, Mode=OneWay}"
                IconGlyph="&#xE774;">
                <StackPanel Spacing="12">
                    <ComboBox Header="{x:Bind ViewModel.LanguageLabel, Mode=OneWay}"
                              ItemsSource="{x:Bind ViewModel.SupportedLanguages, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}"
                              DisplayMemberPath="NativeName"
                              MinWidth="260" />

                    <TextBlock Text="{x:Bind ViewModel.LanguageNote, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </controls:SectionCardControl>

            <!-- Appearance & System Backdrop Section Card -->
            <controls:SectionCardControl
                Title="{x:Bind ViewModel.AppearanceTitle, Mode=OneWay}"
                Subtitle="{x:Bind ViewModel.AppearanceSubtitle, Mode=OneWay}"
                IconGlyph="&#xE790;">
                <StackPanel Spacing="16">
                    <ComboBox Header="{x:Bind ViewModel.ThemeLabel, Mode=OneWay}"
                              ItemsSource="{x:Bind ViewModel.ThemeOptions, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}"
                              MinWidth="220" />

                    <ToggleSwitch Header="{x:Bind ViewModel.BackdropLabel, Mode=OneWay}"
                                  IsOn="{x:Bind ViewModel.EnableMicaAlt, Mode=TwoWay}" />

                    <Button Content="{x:Bind ViewModel.SavePreferencesLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SaveSettingsCommand}"
                            Style="{ThemeResource AccentButtonStyle}" />

                    <!-- Status Notice Banner (Auto-dismisses in 5s) -->
                    <InfoBar IsOpen="{x:Bind ViewModel.HasStatusNotice, Mode=TwoWay}"
                             Severity="Success"
                             IsClosable="True"
                             Message="{x:Bind ViewModel.StatusNotice, Mode=OneWay}" />
                </StackPanel>
            </controls:SectionCardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
