<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OmniForge.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:OmniForge.App.Controls"
    xmlns:models="using:OmniForge.Core.Models"
    xmlns:vm="using:OmniForge.App.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageRootStackPanelStyle}">
            <controls:ToolHeaderControl
                Title="{Binding Source={StaticResource Loc}, Path=[Settings_Title]}"
                Subtitle="{Binding Source={StaticResource Loc}, Path=[Settings_Subtitle]}" />

            <!-- Language & Regional Preferences Section Card -->
            <controls:SectionCardControl
                Title="{Binding Source={StaticResource Loc}, Path=[Settings_Language_Title]}"
                Subtitle="{Binding Source={StaticResource Loc}, Path=[Settings_Language_Subtitle]}"
                IconGlyph="&#xE774;">
                <StackPanel Spacing="12">
                    <ComboBox Header="{Binding Source={StaticResource Loc}, Path=[Settings_Language_Label]}"
                              ItemsSource="{x:Bind ViewModel.SupportedLanguages, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}"
                              DisplayMemberPath="NativeName"
                              MinWidth="260" />

                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Settings_Language_Note]}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </controls:SectionCardControl>

            <!-- Appearance & System Backdrop Section Card -->
            <controls:SectionCardControl
                Title="{Binding Source={StaticResource Loc}, Path=[Settings_Appearance_Title]}"
                Subtitle="{Binding Source={StaticResource Loc}, Path=[Settings_Appearance_Subtitle]}"
                IconGlyph="&#xE790;">
                <StackPanel Spacing="16">
                    <ComboBox Header="{Binding Source={StaticResource Loc}, Path=[Settings_Theme]}"
                              ItemsSource="{x:Bind ViewModel.ThemeOptions, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}"
                              MinWidth="220" />

                    <ToggleSwitch Header="{Binding Source={StaticResource Loc}, Path=[Settings_MicaBackdrop]}"
                                  IsOn="{x:Bind ViewModel.EnableMicaAlt, Mode=TwoWay}" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[Common_Version]}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Button Content="{Binding Source={StaticResource Loc}, Path=[Settings_SavePreferences]}"
                            Command="{x:Bind ViewModel.SaveSettingsCommand}"
                            Style="{ThemeResource AccentButtonStyle}" />

                    <TextBlock Text="{x:Bind ViewModel.StatusNotice, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                               Visibility="{x:Bind ViewModel.HasStatusNotice, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </controls:SectionCardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
