<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OmniForge.App.Modules.BatchRename.BatchRenamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:OmniForge.App.Controls"
    xmlns:local="using:OmniForge.App.Modules.BatchRename"
    xmlns:batchops="using:OmniForge.Modules.BatchOps"
    mc:Ignorable="d">

    <Grid RowSpacing="12" Padding="{StaticResource OmniPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tool Header -->
        <controls:ToolHeaderControl
            Grid.Row="0"
            Title="Batch File &amp; Path Renamer"
            Subtitle="Chained transformation rules, live collision detection, and non-blocking batch renaming"
            HasError="{x:Bind ViewModel.HasError, Mode=OneWay}"
            ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

        <!-- Top CommandBar -->
        <Border Grid.Row="1" Style="{StaticResource FluentCardBorderStyle}" Padding="8,4">
            <CommandBar DefaultLabelPosition="Right" Background="Transparent" IsOpen="False">
                <AppBarButton Icon="OpenFile" Label="Add Files" Command="{x:Bind ViewModel.AddFilesCommand}" />
                <AppBarButton Icon="Folder" Label="Add Folder" Command="{x:Bind ViewModel.AddFolderCommand}" />
                <AppBarSeparator />
                <AppBarButton Icon="Clear" Label="Clear" Command="{x:Bind ViewModel.ClearFilesCommand}" />
                <AppBarSeparator />
                <AppBarButton
                    Icon="Play"
                    Label="Run Rename"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.RunRenameCommand}"
                    IsEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}" />
                <AppBarButton
                    Icon="Undo"
                    Label="{x:Bind ViewModel.UndoStatusText, Mode=OneWay}"
                    Command="{x:Bind ViewModel.UndoRenameCommand}"
                    IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}" />
            </CommandBar>
        </Border>

        <!-- Main Content Area: Split into Left (Rule Builder) and Right (Files Preview) -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Rule Builder Panel -->
            <Border Grid.Column="0" Style="{StaticResource FluentCardBorderStyle}" Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Rule Builder Header with Add Rule DropDown -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Rename Rules" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="Applied in top-down sequence" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <DropDownButton Grid.Column="1" Content="Add Rule">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Text="Prefix / Suffix" Icon="Add" Command="{x:Bind ViewModel.AddRuleCommand}" CommandParameter="PrefixSuffix" />
                                    <MenuFlyoutItem Text="Search &amp; Replace" Icon="Find" Command="{x:Bind ViewModel.AddRuleCommand}" CommandParameter="Replace" />
                                    <MenuFlyoutItem Text="Change Case" Icon="Font" Command="{x:Bind ViewModel.AddRuleCommand}" CommandParameter="ChangeCase" />
                                    <MenuFlyoutItem Text="Numbering" Icon="List" Command="{x:Bind ViewModel.AddRuleCommand}" CommandParameter="Numbering" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>

                    <!-- Scrollable Rules List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Rules, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:RuleItemViewModel">
                                    <Border
                                        Margin="0,0,0,12"
                                        Padding="14"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <StackPanel Spacing="10">
                                            <!-- Rule Card Header -->
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <FontIcon Grid.Column="0" Glyph="{x:Bind IconGlyph}" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontWeight="Medium" VerticalAlignment="Center" Margin="6,0,0,0" />

                                                <ToggleSwitch Grid.Column="2" IsOn="{x:Bind IsActive, Mode=TwoWay}" MinWidth="0" ToolTipService.ToolTip="Enable/Disable Rule" VerticalAlignment="Center" />
                                                <Button Grid.Column="3" Padding="6,4" ToolTipService.ToolTip="Move Up" Command="{x:Bind MoveUpCommand}">
                                                    <FontIcon Glyph="&#xE74A;" FontSize="11" />
                                                </Button>
                                                <Button Grid.Column="4" Padding="6,4" ToolTipService.ToolTip="Move Down" Command="{x:Bind MoveDownCommand}">
                                                    <FontIcon Glyph="&#xE74B;" FontSize="11" />
                                                </Button>
                                                <Button Grid.Column="5" Padding="6,4" ToolTipService.ToolTip="Delete Rule" Command="{x:Bind RemoveCommand}">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                </Button>
                                            </Grid>

                                            <!-- Prefix / Suffix Editor -->
                                            <StackPanel Spacing="8" Visibility="{x:Bind IsPrefixSuffix, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBox Header="Prefix" Text="{x:Bind Prefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. IMG_" />
                                                <TextBox Header="Suffix" Text="{x:Bind Suffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. _v1" />
                                            </StackPanel>

                                            <!-- Search & Replace Editor -->
                                            <StackPanel Spacing="8" Visibility="{x:Bind IsReplace, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBox Header="Search For" Text="{x:Bind SearchPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. IMG or \d+" />
                                                <TextBox Header="Replace With" Text="{x:Bind Replacement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. Photo_{date}" />
                                                <StackPanel Orientation="Horizontal" Spacing="16">
                                                    <CheckBox Content="Match Case" IsChecked="{x:Bind MatchCase, Mode=TwoWay}" />
                                                    <CheckBox Content="Regex" IsChecked="{x:Bind UseRegex, Mode=TwoWay}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Change Case Editor -->
                                            <StackPanel Spacing="8" Visibility="{x:Bind IsChangeCase, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <ComboBox Header="Case Style" SelectedIndex="{x:Bind SelectedCaseIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                                    <ComboBoxItem Content="lowercase" />
                                                    <ComboBoxItem Content="UPPERCASE" />
                                                    <ComboBoxItem Content="Title Case" />
                                                </ComboBox>
                                            </StackPanel>

                                            <!-- Numbering Editor -->
                                            <StackPanel Spacing="8" Visibility="{x:Bind IsNumbering, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Header="Start" Text="{x:Bind StartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBox Grid.Column="1" Header="Step" Text="{x:Bind Step, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBox Grid.Column="2" Header="Padding" Text="{x:Bind PaddingFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="001" />
                                                </Grid>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox Grid.Column="0" Header="Position" SelectedIndex="{x:Bind SelectedPositionIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                                        <ComboBoxItem Content="Suffix" />
                                                        <ComboBoxItem Content="Prefix" />
                                                    </ComboBox>
                                                    <TextBox Grid.Column="1" Header="Separator" Text="{x:Bind Separator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right: Files Preview & Collision Detection Panel -->
            <Border Grid.Column="1" Style="{StaticResource FluentCardBorderStyle}" Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Preview Section Header & Badges -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="Staged Files &amp; Preview" FontWeight="SemiBold" FontSize="15" />

                            <Border Style="{StaticResource StatusBadgeBorderStyle}">
                                <TextBlock Text="{x:Bind ViewModel.TotalFilesCount, Mode=OneWay}" FontSize="12" />
                            </Border>

                            <Border Style="{StaticResource StatusBadgeBorderStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="LightSeaGreen" />
                                    <TextBlock Text="{x:Bind ViewModel.ChangedFilesCount, Mode=OneWay}" FontSize="12" />
                                    <TextBlock Text="to rename" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border
                            Grid.Column="1"
                            Style="{StaticResource StatusBadgeBorderStyle}"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            Visibility="{x:Bind ViewModel.HasConflicts, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE783;" FontSize="12" Foreground="OrangeRed" />
                                <TextBlock Text="{x:Bind ViewModel.ConflictCount, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" Foreground="OrangeRed" />
                                <TextBlock Text="collision(s)" FontSize="12" Foreground="OrangeRed" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Collision Warning Banner -->
                    <InfoBar
                        Grid.Row="1"
                        IsOpen="{x:Bind ViewModel.HasConflicts, Mode=OneWay}"
                        Severity="Warning"
                        IsClosable="False"
                        Title="Collision or Validation Error Detected"
                        Message="Resolve all filename collisions or invalid characters before running the rename batch." />

                    <!-- Drag & Drop Container with Table / Fast ListView -->
                    <Grid
                        Grid.Row="2"
                        AllowDrop="True"
                        DragOver="OnDragOver"
                        Drop="OnDrop"
                        Background="Transparent">

                        <!-- Empty State Placeholder -->
                        <controls:EmptyStateControl
                            IconGlyph="&#xE8AC;"
                            Title="No files imported yet"
                            Subtitle="Click 'Add Files', 'Add Folder', or drag and drop files and directories directly here."
                            IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

                        <!-- Staged Files Table Grid -->
                        <Grid Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Table Header Row -->
                            <Grid
                                Grid.Row="0"
                                Padding="12,8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="4"
                                Margin="0,0,0,6"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Status" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Original Name" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="" />
                                <TextBlock Grid.Column="3" Text="Proposed New Name" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" Text="Type" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="5" Text="Size" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" TextAlignment="Right" />
                            </Grid>

                            <!-- Virtualized Fast Items List -->
                            <ListView
                                Grid.Row="1"
                                ItemsSource="{x:Bind ViewModel.PreviewItems, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="batchops:RenamePreviewItem">
                                        <Grid Padding="0,6" ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind ValidationError, Mode=OneTime}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Status Icon -->
                                            <FontIcon
                                                Grid.Column="0"
                                                Glyph="&#xE783;"
                                                FontSize="14"
                                                Foreground="OrangeRed"
                                                Visibility="{x:Bind HasConflict, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <FontIcon
                                                Grid.Column="0"
                                                Glyph="&#xE73E;"
                                                FontSize="14"
                                                Foreground="LightSeaGreen"
                                                Visibility="{x:Bind HasChange, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <!-- Original Name -->
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind OriginalFileName, Mode=OneTime}"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />

                                            <!-- Direction Arrow -->
                                            <FontIcon
                                                Grid.Column="2"
                                                Glyph="&#xE72A;"
                                                FontSize="11"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                            <!-- Proposed New Name -->
                                            <TextBlock
                                                Grid.Column="3"
                                                Text="{x:Bind ProposedFileName, Mode=OneTime}"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />

                                            <!-- Extension -->
                                            <TextBlock
                                                Grid.Column="4"
                                                Text="{x:Bind Extension, Mode=OneTime}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                VerticalAlignment="Center" />

                                            <!-- File Size -->
                                            <TextBlock
                                                Grid.Column="5"
                                                Text="{x:Bind FormattedSize, Mode=OneTime}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextAlignment="Right"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status & Progress Footer -->
        <controls:StatusFooterControl
            Grid.Row="3"
            IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
            IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
            ProgressPercent="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
            StatusMessage="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            DurationText="{x:Bind ViewModel.LastDurationText, Mode=OneWay}" />
    </Grid>
</Page>
