<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OmniForge.App.Modules.Checksum.ChecksumPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:OmniForge.App.Controls"
    mc:Ignorable="d">

    <ScrollViewer x:Name="RootScrollViewer"
                  Style="{StaticResource PageScrollViewerStyle}"
                  AllowDrop="True"
                  DragOver="OnDragOver"
                  Drop="OnDrop">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveStates">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="980" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootScrollViewer.Padding" Value="{StaticResource OmniCompactPagePadding}" />
                        <Setter Target="AlgorithmBarRow1.Height" Value="Auto" />
                        <Setter Target="AlgorithmCol1.Width" Value="0" />
                        <Setter Target="ComputeBtn.(Grid.Row)" Value="1" />
                        <Setter Target="ComputeBtn.(Grid.Column)" Value="0" />
                        <Setter Target="ComputeBtn.HorizontalAlignment" Value="Left" />
                        <Setter Target="FileSizeBadge.(Grid.Row)" Value="1" />
                        <Setter Target="FileSizeBadge.(Grid.Column)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel Style="{StaticResource PageRootStackPanelStyle}">
            <controls:ToolHeaderControl
                Title="{Binding Source={StaticResource Loc}, Path=[Checksum_Title]}"
                Subtitle="{Binding Source={StaticResource Loc}, Path=[Checksum_Subtitle]}"
                HasError="{x:Bind ViewModel.HasError, Mode=TwoWay}"
                ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=TwoWay}" />

            <!-- File Selection & Algorithm Card -->
            <controls:SectionCardControl
                Title="Target File &amp; Algorithm"
                Subtitle="Select or drop a file; switching algorithms automatically recomputes the digest"
                IconGlyph="&#xE8B7;">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{x:Bind ViewModel.TargetFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Drop a file anywhere on this page or browse file path..." />

                        <Button Grid.Column="1"
                                Content="Browse..."
                                Command="{x:Bind ViewModel.BrowseFileCommand}" />

                        <Button Grid.Column="2"
                                Content="Clear"
                                Command="{x:Bind ViewModel.ClearAllCommand}" />
                    </Grid>

                    <Grid x:Name="AlgorithmBarGrid" Grid.Row="1" ColumnSpacing="12" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="AlgorithmBarRow1" Height="0" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="AlgorithmCol0" Width="Auto" />
                            <ColumnDefinition x:Name="AlgorithmCol1" Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Row="0" Grid.Column="0"
                                  Header="Algorithm"
                                  ItemsSource="{x:Bind ViewModel.AvailableAlgorithms, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedAlgorithm, Mode=TwoWay}"
                                  MinWidth="150" />

                        <Button x:Name="ComputeBtn"
                                Grid.Row="0" Grid.Column="1"
                                Content="Compute Checksum"
                                Command="{x:Bind ViewModel.ComputeHashCommand}"
                                IsEnabled="{x:Bind ViewModel.CanCompute, Mode=OneWay}"
                                Style="{ThemeResource AccentButtonStyle}"
                                VerticalAlignment="Bottom" />

                        <Border x:Name="FileSizeBadge"
                                Grid.Row="0" Grid.Column="2"
                                Style="{StaticResource StatusBadgeBorderStyle}"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="File Size:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                <TextBlock Text="{x:Bind ViewModel.FormattedFileSize, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </controls:SectionCardControl>

            <!-- Computed Digest Card -->
            <controls:SectionCardControl
                Title="Computed Cryptographic Digest"
                Subtitle="Hexadecimal checksum formatted in lower-case"
                IconGlyph="&#xE8D7;">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{x:Bind ViewModel.ComputedHash, Mode=OneWay}"
                             IsReadOnly="True"
                             FontFamily="Consolas, Cascadia Code, Courier New"
                             PlaceholderText="Computed hash will appear here..." />

                    <Button Grid.Column="1"
                            ToolTipService.ToolTip="Copy Checksum"
                            Command="{x:Bind ViewModel.CopyComputedHashCommand}"
                            IsEnabled="{x:Bind ViewModel.HasComputedHash, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            <TextBlock Text="Copy" />
                        </StackPanel>
                    </Button>
                </Grid>
            </controls:SectionCardControl>

            <!-- Checksum Matcher & Verification Card -->
            <controls:SectionCardControl
                Title="Integrity Verification"
                Subtitle="Paste an expected hash for instant automatic comparison"
                IconGlyph="&#xE8FB;">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{x:Bind ViewModel.ExpectedHash, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas, Cascadia Code, Courier New"
                                 PlaceholderText="Paste expected SHA256 / MD5 / SHA512 hash..." />

                        <Button Grid.Column="1"
                                Content="Paste"
                                Command="{x:Bind ViewModel.PasteExpectedHashCommand}" />

                        <Button Grid.Column="2"
                                Content="Verify Match"
                                Command="{x:Bind ViewModel.VerifyHashComparisonCommand}" />
                    </Grid>

                    <!-- Match Success Banner -->
                    <InfoBar Grid.Row="1"
                             IsOpen="{x:Bind ViewModel.IsHashMatch, Mode=OneWay}"
                             Severity="Success"
                             IsClosable="False"
                             Title="Checksum Verified"
                             Message="{x:Bind ViewModel.ComparisonStatusText, Mode=OneWay}" />

                    <!-- Match Failure Banner -->
                    <InfoBar Grid.Row="1"
                             IsOpen="{x:Bind ViewModel.IsHashMismatch, Mode=OneWay}"
                             Severity="Error"
                             IsClosable="False"
                             Title="Checksum Mismatch"
                             Message="{x:Bind ViewModel.ComparisonStatusText, Mode=OneWay}" />
                </Grid>
            </controls:SectionCardControl>

            <!-- Status & Timing Footer at Bottom -->
            <controls:StatusFooterControl
                IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                ProgressPercent="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                StatusMessage="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                DurationText="{x:Bind ViewModel.LastDurationText, Mode=OneWay}"
                CancelCommand="{x:Bind ViewModel.CancelCurrentOperationCommand}" />
        </StackPanel>
    </ScrollViewer>
</Page>

