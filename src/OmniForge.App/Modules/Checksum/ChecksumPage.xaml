<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OmniForge.App.Modules.Checksum.ChecksumPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:OmniForge.App.Controls"
    mc:Ignorable="d">

    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageRootStackPanelStyle}">
            <controls:ToolHeaderControl
                Title="File Hash &amp; Integrity Validator"
                Subtitle="High-performance streaming cryptographic checksums with zero LOH memory allocation"
                HasError="{x:Bind ViewModel.HasError, Mode=OneWay}"
                ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

            <!-- File Selection & Algorithm Card -->
            <controls:SectionCardControl
                Title="Target File &amp; Algorithm"
                Subtitle="Select a file and choose the hashing algorithm (MD5, SHA-1, SHA-256, SHA-384, SHA-512)"
                IconGlyph="&#xE8B7;">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{x:Bind ViewModel.TargetFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Enter or browse file path to calculate checksum..."
                                 AllowDrop="True"
                                 DragOver="OnDragOver"
                                 Drop="OnDrop" />

                        <Button Grid.Column="1"
                                Content="Browse..."
                                Command="{x:Bind ViewModel.BrowseFileCommand}" />

                        <Button Grid.Column="2"
                                Content="Clear"
                                Command="{x:Bind ViewModel.ClearAllCommand}" />
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  Header="Algorithm"
                                  ItemsSource="{x:Bind ViewModel.AvailableAlgorithms, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedAlgorithm, Mode=TwoWay}"
                                  MinWidth="140" />

                        <Button Grid.Column="1"
                                Content="Compute Checksum"
                                Command="{x:Bind ViewModel.ComputeHashCommand}"
                                IsEnabled="{x:Bind ViewModel.CanCompute, Mode=OneWay}"
                                Style="{ThemeResource AccentButtonStyle}"
                                VerticalAlignment="Bottom" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                            <TextBlock Text="File Size:" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.FormattedFileSize, Mode=OneWay}" Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </controls:SectionCardControl>

            <controls:StatusFooterControl
                IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                ProgressPercent="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                StatusMessage="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                DurationText="{x:Bind ViewModel.LastDurationText, Mode=OneWay}" />

            <!-- Computed Digest Card -->
            <controls:SectionCardControl
                Title="Computed Cryptographic Digest"
                Subtitle="Hexadecimal checksum formatted in lower-case"
                IconGlyph="&#xE8D7;">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{x:Bind ViewModel.ComputedHash, Mode=OneWay}"
                             IsReadOnly="True"
                             FontFamily="Consolas, Cascadia Code, Courier New"
                             PlaceholderText="Computed hash will appear here..." />

                    <Button Grid.Column="1"
                            ToolTipService.ToolTip="Copy Checksum"
                            Command="{x:Bind ViewModel.CopyComputedHashCommand}"
                            IsEnabled="{x:Bind ViewModel.HasComputedHash, Mode=OneWay}">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                    </Button>
                </Grid>
            </controls:SectionCardControl>

            <!-- Checksum Matcher & Verification Card -->
            <controls:SectionCardControl
                Title="Integrity Verification"
                Subtitle="Paste an expected hash to verify file authenticity"
                IconGlyph="&#xE8FB;">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{x:Bind ViewModel.ExpectedHash, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas, Cascadia Code, Courier New"
                                 PlaceholderText="Paste expected SHA256 / MD5 / SHA512 hash..." />

                        <Button Grid.Column="1"
                                Content="Verify Match"
                                Command="{x:Bind ViewModel.VerifyHashComparisonCommand}" />
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{x:Bind ViewModel.ComparisonStatusText, Mode=OneWay}"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Visibility="{x:Bind ViewModel.HasComparison, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </controls:SectionCardControl>
        </StackPanel>
    </ScrollViewer>
</Page>

