<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OmniForge.App.Modules.Dashboard.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:OmniForge.App.Controls"
    xmlns:vm="using:OmniForge.App.Modules.Dashboard"
    mc:Ignorable="d">

    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageRootStackPanelStyle}">
            <controls:ToolHeaderControl
                Title="OmniForge Dashboard"
                Subtitle="Centralized workspace &amp; modular utility hub"
                HasError="{x:Bind ViewModel.HasError, Mode=OneWay}"
                ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Active Modules Card (Using Reusable SectionCardControl) -->
                <controls:SectionCardControl
                    Grid.Column="0"
                    Title="Modular System Status"
                    Subtitle="Zero-touch auto-discovered IToolModule plugins"
                    IconGlyph="&#xE74C;">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.WelcomeMessage, Mode=OneWay}"
                                   Style="{ThemeResource BodyTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Registered Tools:" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.RegisteredModuleCount, Mode=OneWay}"
                                       Style="{ThemeResource BodyTextBlockStyle}" />
                        </StackPanel>
                    </StackPanel>
                </controls:SectionCardControl>

                <!-- Architectural Overview Card (Using Reusable SectionCardControl) -->
                <controls:SectionCardControl
                    Grid.Column="1"
                    Title="Foundation Highlights"
                    Subtitle="Clean Architecture &amp; Fluent Design System"
                    IconGlyph="&#xE943;">
                    <StackPanel Spacing="8">
                        <TextBlock Text="• Windows App SDK &amp; WinUI 3 with MicaAlt Backdrop" />
                        <TextBlock Text="• Shared Controls (ToolHeader, SectionCard, StatusFooter, EmptyState)" />
                        <TextBlock Text="• Decoupled DI services (FilePicker, Clipboard, FileSystem, Settings)" />
                    </StackPanel>
                </controls:SectionCardControl>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
