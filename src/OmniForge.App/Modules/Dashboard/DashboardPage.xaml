<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Name="RootPage"
    x:Class="OmniForge.App.Modules.Dashboard.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:OmniForge.App.Controls"
    xmlns:contracts="using:OmniForge.Core.Contracts"
    xmlns:vm="using:OmniForge.App.Modules.Dashboard"
    mc:Ignorable="d">

    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageRootStackPanelStyle}">
            <controls:ToolHeaderControl
                Title="OmniForge Dashboard"
                Subtitle="Centralized workspace &amp; modular utility hub"
                HasError="{x:Bind ViewModel.HasError, Mode=OneWay}"
                ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Active Modules Card -->
                <controls:SectionCardControl
                    Grid.Column="0"
                    Title="Modular System Status"
                    Subtitle="Zero-touch auto-discovered IToolModule plugins"
                    IconGlyph="&#xE74C;">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.WelcomeMessage, Mode=OneWay}"
                                   Style="{ThemeResource BodyTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Registered Tools:" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.RegisteredModuleCount, Mode=OneWay}"
                                       Style="{ThemeResource BodyTextBlockStyle}" />
                        </StackPanel>
                    </StackPanel>
                </controls:SectionCardControl>

                <!-- Architectural Overview Card -->
                <controls:SectionCardControl
                    Grid.Column="1"
                    Title="Foundation Highlights"
                    Subtitle="Clean Architecture &amp; Fluent Design System"
                    IconGlyph="&#xE943;">
                    <StackPanel Spacing="8">
                        <TextBlock Text="• Windows App SDK &amp; WinUI 3 with MicaAlt Backdrop" />
                        <TextBlock Text="• Shared Controls (ToolHeader, SectionCard, StatusFooter, EmptyState)" />
                        <TextBlock Text="• Decoupled DI services (FilePicker, Clipboard, FileSystem, Settings)" />
                    </StackPanel>
                </controls:SectionCardControl>
            </Grid>

            <!-- Quick Launch Available Modules -->
            <controls:SectionCardControl
                Title="Available Utilities"
                Subtitle="Select a tool module to launch directly"
                IconGlyph="&#xE71D;">
                <ItemsControl ItemsSource="{x:Bind ViewModel.AvailableTools, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DashboardToolItemViewModel">
                            <Border
                                Margin="0,0,0,8"
                                Padding="12"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0"
                                              Glyph="{x:Bind IconGlyph}"
                                              FontSize="20"
                                              Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                                              VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind DisplayName}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="4"
                                                    Padding="6,1">
                                                <TextBlock Text="{x:Bind Category}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Description}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Content="Launch"
                                            Command="{x:Bind LaunchCommand}"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </controls:SectionCardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
