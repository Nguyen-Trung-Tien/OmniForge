<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Name="RootPage"
    x:Class="OmniForge.App.Modules.Dashboard.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:OmniForge.App.Controls"
    xmlns:contracts="using:OmniForge.Core.Contracts"
    xmlns:vm="using:OmniForge.App.Modules.Dashboard"
    mc:Ignorable="d">

    <ScrollViewer x:Name="RootScrollViewer" Style="{StaticResource PageScrollViewerStyle}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveStates">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="980" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootScrollViewer.Padding" Value="{StaticResource OmniCompactPagePadding}" />
                        <Setter Target="StatusCol1.Width" Value="0" />
                        <Setter Target="HighlightsCard.(Grid.Row)" Value="1" />
                        <Setter Target="HighlightsCard.(Grid.Column)" Value="0" />
                        <Setter Target="FilterCol0.Width" Value="*" />
                        <Setter Target="FilterCol1.Width" Value="0" />
                        <Setter Target="FilterCol2.Width" Value="0" />
                        <Setter Target="FilterBox.(Grid.Row)" Value="1" />
                        <Setter Target="FilterBox.(Grid.Column)" Value="0" />
                        <Setter Target="FilterBox.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="FilterBox.Margin" Value="0,10,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel Style="{StaticResource PageRootStackPanelStyle}">
            <controls:ToolHeaderControl
                Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                Subtitle="{x:Bind ViewModel.PageSubtitle, Mode=OneWay}"
                HasError="{x:Bind ViewModel.HasError, Mode=TwoWay}"
                ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=TwoWay}" />

            <!-- System Architecture & Active Modules Overview -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="StatusCol0" Width="*" />
                    <ColumnDefinition x:Name="StatusCol1" Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Active System Status Card -->
                <controls:SectionCardControl
                    Grid.Row="0"
                    Grid.Column="0"
                    Title="{x:Bind ViewModel.SystemStatusTitle, Mode=OneWay}"
                    Subtitle="{x:Bind ViewModel.SystemStatusSubtitle, Mode=OneWay}"
                    IconGlyph="&#xE9D9;">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.WelcomeMessage, Mode=OneWay}"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Style="{StaticResource StatusBadgeBorderStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.RegisteredToolsLabel, Mode=OneWay}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.RegisteredModuleCount, Mode=OneWay}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Button Content="Refresh"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    Padding="8,4"
                                    Command="{x:Bind ViewModel.RefreshStatisticsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </controls:SectionCardControl>

                <!-- Architecture & Performance Highlights Card -->
                <controls:SectionCardControl
                    x:Name="HighlightsCard"
                    Grid.Row="0"
                    Grid.Column="1"
                    Title="{x:Bind ViewModel.HighlightsTitle, Mode=OneWay}"
                    Subtitle="{x:Bind ViewModel.HighlightsSubtitle, Mode=OneWay}"
                    IconGlyph="&#xE945;">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.Highlight1, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.Highlight2, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.Highlight3, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </controls:SectionCardControl>
            </Grid>

            <!-- Quick Filter & Workspace Status Bar -->
            <Border Style="{StaticResource FluentCardBorderStyle}" Padding="16,12">
                <Grid ColumnSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="FilterCol0" Width="Auto" />
                        <ColumnDefinition x:Name="FilterCol1" Width="*" />
                        <ColumnDefinition x:Name="FilterCol2" Width="280" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE71D;"
                                  FontSize="20"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  VerticalAlignment="Center" />

                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.AvailableUtilitiesTitle, Mode=OneWay}"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.AvailableUtilitiesSubtitle, Mode=OneWay}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBox x:Name="FilterBox"
                             Grid.Row="0"
                             Grid.Column="2"
                             PlaceholderText="{x:Bind ViewModel.FilterPlaceholder, Mode=OneWay}"
                             Text="{x:Bind ViewModel.FilterQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Quick Launch Available Modules Grid -->
            <GridView ItemsSource="{x:Bind ViewModel.AvailableTools, Mode=OneWay}"
                      SelectionMode="None"
                      IsItemClickEnabled="False">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" ItemWidth="370" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,0,16,16" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DashboardToolItemViewModel">
                        <Border
                            Padding="16,14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="40"
                                        Height="40"
                                        CornerRadius="8"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind IconGlyph}"
                                              FontSize="18"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <!-- Eyebrow Category Badge -->
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Padding="6,1"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{x:Bind Category}"
                                                   FontSize="10"
                                                   FontWeight="Medium"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>

                                    <!-- Full Tool Display Name -->
                                    <TextBlock Text="{x:Bind DisplayName}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Tool Description -->
                                    <TextBlock Text="{x:Bind Description}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               MaxLines="2"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Content="{x:Bind LaunchText}"
                                        Command="{x:Bind LaunchCommand}"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- Status & Timing Footer -->
            <controls:StatusFooterControl
                IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                ProgressPercent="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                StatusMessage="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                DurationText="{x:Bind ViewModel.LastDurationText, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
