<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OmniForge.App.Modules.TextInspector.TextInspectorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:OmniForge.App.Controls"
    xmlns:models="using:OmniForge.Core.Modules.TextInspector"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" RowSpacing="12" Padding="{StaticResource OmniPagePadding}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveStates">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="980" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootGrid.Padding" Value="{StaticResource OmniCompactPagePadding}" />
                        <Setter Target="SplitCol0.Width" Value="*" />
                        <Setter Target="SplitCol1.Width" Value="0" />
                        <Setter Target="SplitRow0.Height" Value="*" />
                        <Setter Target="SplitRow1.Height" Value="*" />
                        <Setter Target="OutputCard.(Grid.Row)" Value="1" />
                        <Setter Target="OutputCard.(Grid.Column)" Value="0" />
                        <Setter Target="OutputCard.Margin" Value="0,12,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:ToolHeaderControl
            Grid.Row="0"
            Title="Text &amp; Payload Inspector"
            Subtitle="Side-by-side JSON/XML formatting, Base64 &amp; URL codecs, JWT decoder, and line-by-line diff"
            HasError="{x:Bind ViewModel.HasError, Mode=TwoWay}"
            ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=TwoWay}" />

        <!-- Unified Toolbar: Mode Selector + Context Actions + Quick Utilities -->
        <Border Grid.Row="1" Style="{StaticResource FluentCardBorderStyle}" Padding="14,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Mode Selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE943;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Mode:" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedModeIndex, Mode=TwoWay}" MinWidth="195" VerticalAlignment="Center">
                        <ComboBoxItem Content="JSON Format &amp; Minify" />
                        <ComboBoxItem Content="XML Format" />
                        <ComboBoxItem Content="Base64 Codec" />
                        <ComboBoxItem Content="URL Codec" />
                        <ComboBoxItem Content="JWT Inspector" />
                        <ComboBoxItem Content="Line Diff Compare" />
                    </ComboBox>
                </StackPanel>

                <!-- Primary Mode Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- JSON Actions -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind ViewModel.IsJsonMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Content="Format JSON"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.FormatJsonCommand}"
                                CommandParameter="indented" />
                        <Button Content="Minify"
                                Command="{x:Bind ViewModel.FormatJsonCommand}"
                                CommandParameter="minify" />
                    </StackPanel>

                    <!-- XML Actions -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind ViewModel.IsXmlMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Content="Format XML"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.FormatXmlCommand}" />
                    </StackPanel>

                    <!-- Base64 Actions -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind ViewModel.IsBase64Mode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Content="Encode Base64"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.EncodeBase64Command}" />
                        <Button Content="Decode Base64"
                                Command="{x:Bind ViewModel.DecodeBase64Command}" />
                    </StackPanel>

                    <!-- URL Actions -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind ViewModel.IsUrlMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Content="URL Encode"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.EncodeUrlCommand}" />
                        <Button Content="URL Decode"
                                Command="{x:Bind ViewModel.DecodeUrlCommand}" />
                    </StackPanel>

                    <!-- JWT Actions -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind ViewModel.IsJwtMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Content="Decode JWT"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.InspectJwtCommand}" />
                    </StackPanel>

                    <!-- Diff Actions -->
                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind ViewModel.IsDiffMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Content="Compute Diff"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.ComputeDiffCommand}" />
                    </StackPanel>
                </StackPanel>

                <!-- Right Common Actions -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Sample"
                            ToolTipService.ToolTip="Load sample payload for current mode"
                            Command="{x:Bind ViewModel.LoadSampleCommand}" />
                    <Button Content="Swap ⇄"
                            ToolTipService.ToolTip="Move Output into Input"
                            Command="{x:Bind ViewModel.SwapInputOutputCommand}"
                            IsEnabled="{x:Bind ViewModel.HasOutput, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsNotDiffMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button Content="Clear"
                            Command="{x:Bind ViewModel.ClearAllCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace (Grid.Row="2") -->
        <Grid Grid.Row="2">
            <!-- Standard Side-by-Side Split View (Input Left, Output Right) -->
            <Grid ColumnSpacing="16"
                  Visibility="{x:Bind ViewModel.IsNotDiffMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="SplitRow0" Height="*" />
                    <RowDefinition x:Name="SplitRow1" Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SplitCol0" Width="*" />
                    <ColumnDefinition x:Name="SplitCol1" Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Input Card -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource FluentCardBorderStyle}" Padding="14">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="Input Payload" FontWeight="SemiBold" FontSize="15" />
                                <Border Style="{StaticResource StatusBadgeBorderStyle}">
                                    <TextBlock Text="{x:Bind ViewModel.InputStatsText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Paste" Command="{x:Bind ViewModel.PasteInputCommand}" />
                        </Grid>

                        <TextBox Grid.Row="1"
                                 Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MonospaceCodeTextBoxStyle}"
                                 VerticalAlignment="Stretch"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 PlaceholderText="Paste JSON, XML, Base64, URL, or JWT string here..." />
                    </Grid>
                </Border>

                <!-- Right: Output Card -->
                <Border x:Name="OutputCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource FluentCardBorderStyle}" Padding="14">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="Transformed Output" FontWeight="SemiBold" FontSize="15" />
                                <Border Style="{StaticResource StatusBadgeBorderStyle}">
                                    <TextBlock Text="{x:Bind ViewModel.OutputStatsText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    ToolTipService.ToolTip="Copy Output"
                                    Command="{x:Bind ViewModel.CopyOutputCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasOutput, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                    <TextBlock Text="Copy" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBox Grid.Row="1"
                                 Text="{x:Bind ViewModel.OutputText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Style="{StaticResource MonospaceCodeTextBoxStyle}"
                                 VerticalAlignment="Stretch"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 PlaceholderText="Transformed output will appear here..." />
                    </Grid>
                </Border>
            </Grid>

            <!-- Diff Mode Workspace -->
            <Grid RowSpacing="14"
                  Visibility="{x:Bind ViewModel.IsDiffMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="180" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource FluentCardBorderStyle}" Padding="12">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Original (Left / -)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBox Grid.Row="1"
                                     Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MonospaceCodeTextBoxStyle}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     PlaceholderText="Original source text..." />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource FluentCardBorderStyle}" Padding="12">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Modified (Right / +)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBox Grid.Row="1"
                                     Text="{x:Bind ViewModel.SecondaryInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MonospaceCodeTextBoxStyle}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     PlaceholderText="Modified comparison text..." />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Diff Result Lines List -->
                <Border Grid.Row="1"
                        Style="{StaticResource FluentCardBorderStyle}"
                        Padding="12">
                    <Grid>
                        <controls:EmptyStateControl
                            IconGlyph="&#xE8E2;"
                            Title="No diff results yet"
                            Subtitle="Enter Original and Modified text above and click 'Compute Diff' or 'Sample' to inspect line differences."
                            IsEmpty="{x:Bind ViewModel.IsDiffEmpty, Mode=OneWay}" />

                        <ListView ItemsSource="{x:Bind ViewModel.DiffResults, Mode=OneWay}"
                                  SelectionMode="None"
                                  Visibility="{x:Bind ViewModel.HasDiffResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:DiffLine">
                                    <Grid ColumnSpacing="8" Padding="6,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Bind LineNumber}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   FontFamily="Consolas, Cascadia Code, Courier New"
                                                   HorizontalAlignment="Right" />

                                        <!-- Semantic Diff Indicator (+ Green, - Red, Space Neutral) -->
                                        <Grid Grid.Column="1">
                                            <TextBlock Text="+"
                                                       FontWeight="Bold"
                                                       FontFamily="Consolas, Cascadia Code, Courier New"
                                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                       Visibility="{x:Bind IsAdded, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock Text="-"
                                                       FontWeight="Bold"
                                                       FontFamily="Consolas, Cascadia Code, Courier New"
                                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                       Visibility="{x:Bind IsRemoved, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock Text=" "
                                                       FontFamily="Consolas, Cascadia Code, Courier New"
                                                       Visibility="{x:Bind IsUnchanged, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>

                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind Content}"
                                                   FontFamily="Consolas, Cascadia Code, Courier New"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom Status Footer -->
        <controls:StatusFooterControl
            Grid.Row="3"
            IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
            IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
            ProgressPercent="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
            StatusMessage="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            DurationText="{x:Bind ViewModel.LastDurationText, Mode=OneWay}" />
    </Grid>
</Page>
