<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OmniForge.App.Modules.TextInspector.TextInspectorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:OmniForge.App.Controls"
    xmlns:models="using:OmniForge.Core.Modules.TextInspector"
    mc:Ignorable="d">

    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
        <StackPanel Style="{StaticResource PageRootStackPanelStyle}">
            <controls:ToolHeaderControl
                Title="Text &amp; Payload Inspector"
                Subtitle="JSON/XML formatting and minification, Base64 &amp; URL codecs, JWT payload decoder, and visual line diff"
                HasError="{x:Bind ViewModel.HasError, Mode=OneWay}"
                ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

            <!-- Mode Selector -->
            <controls:SectionCardControl
                Title="Utility Tool Mode"
                Subtitle="Select a payload transformation or inspection workflow"
                IconGlyph="&#xE71E;">
                <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedModeIndex, Mode=TwoWay}" MinWidth="260">
                    <ComboBoxItem Content="JSON Format &amp; Minify" />
                    <ComboBoxItem Content="XML Format" />
                    <ComboBoxItem Content="Base64 Codec" />
                    <ComboBoxItem Content="URL Codec" />
                    <ComboBoxItem Content="JWT Inspector" />
                    <ComboBoxItem Content="Line Diff" />
                </ComboBox>
            </controls:SectionCardControl>

            <controls:StatusFooterControl
                IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                ProgressPercent="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                StatusMessage="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                DurationText="{x:Bind ViewModel.LastDurationText, Mode=OneWay}" />

            <!-- JSON Actions Bar (when Mode == 0) -->
            <Border Style="{StaticResource FluentCardBorderStyle}"
                    Padding="12,8"
                    Visibility="{x:Bind ViewModel.IsJsonMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Format Indented"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.FormatJsonCommand}"
                            CommandParameter="indented" />
                    <Button Content="Minify Compact"
                            Command="{x:Bind ViewModel.FormatJsonCommand}"
                            CommandParameter="minify" />
                </StackPanel>
            </Border>

            <!-- XML Actions Bar (when Mode == 1) -->
            <Border Style="{StaticResource FluentCardBorderStyle}"
                    Padding="12,8"
                    Visibility="{x:Bind ViewModel.IsXmlMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Format XML"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.FormatXmlCommand}" />
                </StackPanel>
            </Border>

            <!-- Base64 Actions Bar (when Mode == 2) -->
            <Border Style="{StaticResource FluentCardBorderStyle}"
                    Padding="12,8"
                    Visibility="{x:Bind ViewModel.IsBase64Mode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Encode to Base64"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.EncodeBase64Command}" />
                    <Button Content="Decode from Base64"
                            Command="{x:Bind ViewModel.DecodeBase64Command}" />
                </StackPanel>
            </Border>

            <!-- URL Actions Bar (when Mode == 3) -->
            <Border Style="{StaticResource FluentCardBorderStyle}"
                    Padding="12,8"
                    Visibility="{x:Bind ViewModel.IsUrlMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="URL Encode"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.EncodeUrlCommand}" />
                    <Button Content="URL Decode"
                            Command="{x:Bind ViewModel.DecodeUrlCommand}" />
                </StackPanel>
            </Border>

            <!-- JWT Actions Bar (when Mode == 4) -->
            <Border Style="{StaticResource FluentCardBorderStyle}"
                    Padding="12,8"
                    Visibility="{x:Bind ViewModel.IsJwtMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Inspect JWT Payload"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.InspectJwtCommand}" />
                </StackPanel>
            </Border>

            <!-- Text & Payload Input Card (Non-diff modes) -->
            <controls:SectionCardControl
                Title="Input Payload"
                Subtitle="Paste or type raw text"
                IconGlyph="&#xE8C8;"
                Visibility="{x:Bind ViewModel.IsNotDiffMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Paste" Command="{x:Bind ViewModel.PasteInputCommand}" />
                        <Button Content="Clear" Command="{x:Bind ViewModel.ClearAllCommand}" />
                    </StackPanel>

                    <TextBox Grid.Row="1"
                             Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             MinHeight="180"
                             MaxHeight="360"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Cascadia Code, Courier New"
                             PlaceholderText="Paste JSON, XML, Base64, URL, or JWT string here..." />
                </Grid>
            </controls:SectionCardControl>

            <!-- Output Payload Card (Non-diff modes) -->
            <controls:SectionCardControl
                Title="Transformed Output"
                Subtitle="Result of formatting, codec, or decoding"
                IconGlyph="&#xE8D7;"
                Visibility="{x:Bind ViewModel.IsNotDiffMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button ToolTipService.ToolTip="Copy Output" Command="{x:Bind ViewModel.CopyOutputCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                <TextBlock Text="Copy" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBox Grid.Row="1"
                             Text="{x:Bind ViewModel.OutputText, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             MinHeight="200"
                             MaxHeight="400"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Cascadia Code, Courier New"
                             PlaceholderText="Output appears here..." />
                </Grid>
            </controls:SectionCardControl>

            <!-- Diff Mode Workspace (when Mode == 5) -->
            <controls:SectionCardControl
                Title="Text Diff Comparison"
                Subtitle="Compare original vs modified text line-by-line"
                IconGlyph="&#xE8AB;"
                Visibility="{x:Bind ViewModel.IsDiffMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Original (Left / -)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBox Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     MinHeight="140"
                                     MaxHeight="220"
                                     FontFamily="Consolas, Cascadia Code, Courier New"
                                     PlaceholderText="Original source text..." />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Modified (Right / +)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBox Text="{x:Bind ViewModel.SecondaryInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     MinHeight="140"
                                     MaxHeight="220"
                                     FontFamily="Consolas, Cascadia Code, Courier New"
                                     PlaceholderText="Modified comparison text..." />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Compute Diff"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.ComputeDiffCommand}" />
                        <Button Content="Clear" Command="{x:Bind ViewModel.ClearAllCommand}" />
                    </StackPanel>

                    <!-- Diff Result Lines List -->
                    <Border Grid.Row="2"
                            Style="{StaticResource FluentCardBorderStyle}"
                            MinHeight="200"
                            Padding="8">
                        <ListView ItemsSource="{x:Bind ViewModel.DiffResults, Mode=OneWay}"
                                  MaxHeight="360"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:DiffLine">
                                    <Grid ColumnSpacing="8" Padding="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Bind LineNumber}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   FontFamily="Consolas, Cascadia Code, Courier New"
                                                   HorizontalAlignment="Right" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind Prefix}"
                                                   FontWeight="Bold"
                                                   FontFamily="Consolas, Cascadia Code, Courier New"
                                                   Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind Content}"
                                                   FontFamily="Consolas, Cascadia Code, Courier New" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </controls:SectionCardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
