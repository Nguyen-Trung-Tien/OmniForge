<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OmniForge.App.Modules.LuckyWheel.LuckyWheelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OmniForge.App.Controls"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:lucky="using:OmniForge.App.Modules.LuckyWheel">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- Main Scrollable Content -->
        <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
            <StackPanel Style="{StaticResource PageRootStackPanelStyle}" MaxWidth="1280">
                <!-- Header Control -->
                <controls:ToolHeaderControl
                    Title="Lucky Wheel"
                    Subtitle="Interactive physics-driven decision wheel with customizable weights and 60/120 FPS Win2D rendering."
                    HasError="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                <!-- Main Layout Grid -->
                <Grid ColumnSpacing="24" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="480" />
                        <ColumnDefinition Width="420" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Wheel Canvas & Spin Controls -->
                    <StackPanel Grid.Column="0" Spacing="16">
                        <!-- Canvas Card Container -->
                        <Border Style="{StaticResource FluentCardBorderStyle}" Padding="12" CornerRadius="12">
                            <Grid Height="540" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8">
                                <canvas:CanvasControl
                                    x:Name="WheelCanvas"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    ClearColor="Transparent"
                                    CreateResources="WheelCanvas_CreateResources"
                                    Draw="WheelCanvas_Draw"
                                    PointerPressed="WheelCanvas_PointerPressed" />
                            </Grid>
                        </Border>

                        <!-- Wheel Action Bar -->
                        <Border Style="{StaticResource FluentCardBorderStyle}" Padding="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Big Spin Action Button -->
                                <Button Grid.Column="0"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Height="48"
                                        Command="{x:Bind ViewModel.StartSpinCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanSpin, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE768;" FontSize="18" />
                                        <TextBlock Text="SPIN WHEEL" FontSize="16" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>

                                <!-- Spin Duration Preset -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Duration:" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <ComboBox SelectedIndex="1" Width="100" SelectionChanged="DurationComboBox_SelectionChanged"
                                              IsEnabled="{x:Bind ViewModel.IsNotSpinning, Mode=OneWay}">
                                        <ComboBoxItem Content="3s Fast" Tag="3.0" />
                                        <ComboBoxItem Content="4.5s Normal" Tag="4.5" />
                                        <ComboBoxItem Content="7s Drama" Tag="7.0" />
                                        <ComboBoxItem Content="10s Epic" Tag="10.0" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- Deceleration Profile -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Profile:" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <ComboBox SelectedIndex="0" Width="130" SelectionChanged="ProfileComboBox_SelectionChanged"
                                              IsEnabled="{x:Bind ViewModel.IsNotSpinning, Mode=OneWay}">
                                        <ComboBoxItem Content="Ease-Out Cubic" />
                                        <ComboBoxItem Content="Exponential" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Right Column: Configuration & Items Panel -->
                    <StackPanel Grid.Column="1" Spacing="16">
                        <controls:SectionCardControl
                            Title="Wheel Options"
                            Subtitle="Manage items, custom ratios, and presets."
                            IconGlyph="&#xE8B7;">
                            <controls:SectionCardControl.HeaderAction>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button ToolTipService.ToolTip="Shuffle Items"
                                            Command="{x:Bind ViewModel.ShuffleItemsCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsNotSpinning, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                                    </Button>

                                    <Button ToolTipService.ToolTip="Import / Paste List"
                                            Command="{x:Bind ViewModel.ImportFromClipboardCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsNotSpinning, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE77F;" FontSize="14" />
                                    </Button>

                                    <!-- Presets Flyout Button -->
                                    <Button Content="Presets"
                                            IsEnabled="{x:Bind ViewModel.IsNotSpinning, Mode=OneWay}">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Decision Maker (Yes/No/Maybe)"
                                                                Click="PresetItem_Click" Tag="Decision Maker" />
                                                <MenuFlyoutItem Text="Lunch Chooser"
                                                                Click="PresetItem_Click" Tag="Lunch Chooser" />
                                                <MenuFlyoutItem Text="Prize Raffle"
                                                                Click="PresetItem_Click" Tag="Prize Raffle" />
                                                <MenuFlyoutItem Text="Team Standup"
                                                                Click="PresetItem_Click" Tag="Team Standup" />
                                                <MenuFlyoutItem Text="Dice Roll (1-6)"
                                                                Click="PresetItem_Click" Tag="Dice Roll (1-6)" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </controls:SectionCardControl.HeaderAction>

                            <controls:SectionCardControl.InnerContent>
                                <StackPanel Spacing="14">
                                    <!-- Add New Item Row -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                 PlaceholderText="New option name..."
                                                 Text="{x:Bind ViewModel.NewItemText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 KeyDown="NewItemTextBox_KeyDown" />

                                        <NumberBox Grid.Column="1"
                                                   PlaceholderText="Weight"
                                                   Value="{x:Bind ViewModel.NewItemWeight, Mode=TwoWay}"
                                                   Minimum="0.1"
                                                   Maximum="50.0"
                                                   SmallChange="0.5"
                                                   SpinButtonPlacementMode="Compact" />

                                        <Button Grid.Column="2"
                                                Style="{ThemeResource AccentButtonStyle}"
                                                Command="{x:Bind ViewModel.AddNewItemCommand}">
                                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                                        </Button>
                                    </Grid>

                                    <!-- Items List Container -->
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            MaxHeight="380">
                                        <ListView ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                                                  SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="lucky:WheelItemViewModel">
                                                    <Grid ColumnSpacing="10" Padding="4,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="65" />
                                                            <ColumnDefinition Width="45" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Color Swatch -->
                                                        <Border Grid.Column="0"
                                                                Width="22" Height="22"
                                                                CornerRadius="11"
                                                                Background="{x:Bind Brush, Mode=OneWay}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                VerticalAlignment="Center" />

                                                        <!-- Text Editor -->
                                                        <TextBox Grid.Column="1"
                                                                 Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 VerticalAlignment="Center" />

                                                        <!-- Weight Box -->
                                                        <NumberBox Grid.Column="2"
                                                                   Value="{x:Bind Weight, Mode=TwoWay}"
                                                                   Minimum="0.1"
                                                                   Maximum="50.0"
                                                                   SmallChange="0.5"
                                                                   SpinButtonPlacementMode="Inline"
                                                                   VerticalAlignment="Center" />

                                                        <!-- Percentage Display -->
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{x:Bind PercentageText, Mode=OneWay}"
                                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right" />

                                                        <!-- Enable / Disable Toggle -->
                                                        <CheckBox Grid.Column="4"
                                                                  IsChecked="{x:Bind IsEnabled, Mode=TwoWay}"
                                                                  MinWidth="30"
                                                                  VerticalAlignment="Center" />

                                                        <!-- Delete Button -->
                                                        <Button Grid.Column="5"
                                                                Padding="6"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Click="DeleteItemButton_Click"
                                                                Tag="{x:Bind}"
                                                                ToolTipService.ToolTip="Delete Option">
                                                            <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Border>

                                    <!-- Bottom Summary Info -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Border Style="{StaticResource StatusBadgeBorderStyle}">
                                                <TextBlock Text="{x:Bind ViewModel.ActiveItemsText, Mode=OneWay}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" />
                                            </Border>
                                            <Border Style="{StaticResource StatusBadgeBorderStyle}">
                                                <TextBlock Text="{x:Bind ViewModel.TotalWeightText, Mode=OneWay}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Multi-Line Import Dialog Trigger -->
                                        <Button Grid.Column="1"
                                                Content="Paste Raw Text..."
                                                Click="OpenImportDialogButton_Click"
                                                IsEnabled="{x:Bind ViewModel.IsNotSpinning, Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>
                            </controls:SectionCardControl.InnerContent>
                        </controls:SectionCardControl>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Celebratory Winner Modal / Dialog Overlay -->
        <Grid Background="#80000000"
              Visibility="{x:Bind ViewModel.IsResultModalOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Border Style="{StaticResource FluentCardBorderStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="440"
                    Padding="28"
                    CornerRadius="16"
                    BorderThickness="2"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
                <StackPanel Spacing="20" HorizontalAlignment="Stretch">
                    <!-- Header Icon & Title -->
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE735;" FontSize="36" Foreground="#F59E0B" HorizontalAlignment="Center" />
                        <TextBlock Text="WE HAVE A WINNER!"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Winning Item Card Banner -->
                    <Border CornerRadius="12"
                            Background="{x:Bind ViewModel.WinningItem.Brush, Mode=OneWay}"
                            Padding="20,16"
                            HorizontalAlignment="Stretch">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.WinningItem.Text, Mode=OneWay}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{x:Bind ViewModel.WinningItem.ContrastForegroundBrush, Mode=OneWay}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.WinningProbabilityText, Mode=OneWay}"
                                       FontSize="13"
                                       Foreground="{x:Bind ViewModel.WinningItem.ContrastForegroundBrush, Mode=OneWay}"
                                       Opacity="0.85"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Height="40"
                                Command="{x:Bind ViewModel.StartSpinCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Text="Spin Again" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Height="40"
                                Command="{x:Bind ViewModel.RemoveWinnerCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                <TextBlock Text="Remove Winner" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.CopyWinnerToClipboardCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                <TextBlock Text="Copy Winner" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.CloseResultModalCommand}"
                                Content="Close" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Import Multi-Line Dialog Overlay -->
        <Grid Background="#80000000"
              Visibility="{x:Bind ViewModel.IsImportDialogOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Border Style="{StaticResource FluentCardBorderStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="480"
                    Padding="24"
                    CornerRadius="12">
                <StackPanel Spacing="16">
                    <TextBlock Text="Import Options From Text"
                               Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Paste one option per line. Optionally append weight: 'Option Name: 2' or 'Option (3)'."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <TextBox Text="{x:Bind ViewModel.ImportPayloadText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MonospaceCodeTextBoxStyle}"
                             Height="180"
                             AcceptsReturn="True"
                             PlaceholderText="Option A&#x0a;Option B: 2.0&#x0a;Option C (3)" />

                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="CancelImportButton_Click" />
                        <Button Content="Import List"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.ExecuteImportCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
