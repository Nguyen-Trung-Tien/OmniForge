<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OmniForge.App.Modules.LuckyWheel.LuckyWheelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OmniForge.App.Controls"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:lucky="using:OmniForge.App.Modules.LuckyWheel">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveStates">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="980" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootScrollViewer.Padding" Value="{StaticResource OmniCompactPagePadding}" />
                        <Setter Target="WheelCol.Width" Value="*" />
                        <Setter Target="WheelCol.MinWidth" Value="0" />
                        <Setter Target="ConfigCol.Width" Value="0" />
                        <Setter Target="ConfigPanel.(Grid.Row)" Value="1" />
                        <Setter Target="ConfigPanel.(Grid.Column)" Value="0" />
                        <Setter Target="ConfigPanel.Margin" Value="0,16,0,0" />
                        <Setter Target="CanvasContainer.Height" Value="380" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Main Scrollable Content -->
        <ScrollViewer x:Name="RootScrollViewer" Style="{StaticResource PageScrollViewerStyle}">
            <StackPanel Style="{StaticResource PageRootStackPanelStyle}">
                <!-- Header Control -->
                <controls:ToolHeaderControl
                    Title="Lucky Wheel"
                    Subtitle="Interactive physics-driven decision wheel with customizable weights and 60/120 FPS Win2D rendering."
                    HasError="{x:Bind ViewModel.HasError, Mode=TwoWay}"
                    ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=TwoWay}" />

                <!-- Main Layout Grid -->
                <Grid ColumnSpacing="20" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="WheelCol" Width="1.15*" MinWidth="360" />
                        <ColumnDefinition x:Name="ConfigCol" Width="430" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Wheel Canvas & Spin Controls -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="14">
                        <!-- Canvas Card Container -->
                        <Border Style="{StaticResource FluentCardBorderStyle}" Padding="12" CornerRadius="12">
                            <Grid x:Name="CanvasContainer" Height="460" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8">
                                <canvas:CanvasControl
                                    x:Name="WheelCanvas"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    ClearColor="Transparent"
                                    CreateResources="WheelCanvas_CreateResources"
                                    Draw="WheelCanvas_Draw"
                                    PointerPressed="WheelCanvas_PointerPressed" />
                            </Grid>
                        </Border>

                        <!-- Wheel Action Bar -->
                        <Border Style="{StaticResource FluentCardBorderStyle}" Padding="14">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Big Spin Action Button -->
                                <Button Grid.Column="0"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Height="46"
                                        Command="{x:Bind ViewModel.StartSpinCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanSpin, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE768;" FontSize="18" />
                                        <TextBlock Text="SPIN WHEEL" FontSize="15" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>

                                <!-- Spin Duration Preset -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Duration:" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <ComboBox SelectedIndex="1" Width="105" SelectionChanged="DurationComboBox_SelectionChanged"
                                              IsEnabled="{x:Bind ViewModel.IsNotSpinning, Mode=OneWay}">
                                        <ComboBoxItem Content="3s Fast" Tag="3.0" />
                                        <ComboBoxItem Content="4.5s Normal" Tag="4.5" />
                                        <ComboBoxItem Content="7s Drama" Tag="7.0" />
                                        <ComboBoxItem Content="10s Epic" Tag="10.0" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- Deceleration Profile -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Profile:" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <ComboBox SelectedIndex="0" Width="125" SelectionChanged="ProfileComboBox_SelectionChanged"
                                              IsEnabled="{x:Bind ViewModel.IsNotSpinning, Mode=OneWay}">
                                        <ComboBoxItem Content="Ease-Out Cubic" />
                                        <ComboBoxItem Content="Exponential" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Right Column: Configuration & Items Panel -->
                    <StackPanel x:Name="ConfigPanel" Grid.Row="0" Grid.Column="1" Spacing="14">
                        <controls:SectionCardControl
                            Title="Wheel Options &amp; Rows"
                            Subtitle="Add rows, adjust weights, or load presets."
                            IconGlyph="&#xE8B7;">
                            <controls:SectionCardControl.HeaderAction>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button ToolTipService.ToolTip="Shuffle Items"
                                            Padding="8,5"
                                            Command="{x:Bind ViewModel.ShuffleItemsCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsNotSpinning, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE8B1;" FontSize="13" />
                                    </Button>

                                    <Button ToolTipService.ToolTip="Equalize All Weights to 1.0"
                                            Padding="8,5"
                                            Command="{x:Bind ViewModel.EqualizeWeightsCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsNotSpinning, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE8EF;" FontSize="13" />
                                    </Button>

                                    <Button ToolTipService.ToolTip="Import / Paste From Clipboard"
                                            Padding="8,5"
                                            Command="{x:Bind ViewModel.ImportFromClipboardCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsNotSpinning, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE77F;" FontSize="13" />
                                    </Button>

                                    <!-- Presets Flyout Button -->
                                    <DropDownButton Content="Presets"
                                                    Padding="8,5"
                                                    FontSize="12"
                                                    IsEnabled="{x:Bind ViewModel.IsNotSpinning, Mode=OneWay}">
                                        <DropDownButton.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem Text="Decision Maker (Yes/No/Maybe)"
                                                                Click="PresetItem_Click" Tag="Decision Maker" />
                                                <MenuFlyoutItem Text="Lunch Chooser"
                                                                Click="PresetItem_Click" Tag="Lunch Chooser" />
                                                <MenuFlyoutItem Text="Prize Raffle"
                                                                Click="PresetItem_Click" Tag="Prize Raffle" />
                                                <MenuFlyoutItem Text="Team Standup"
                                                                Click="PresetItem_Click" Tag="Team Standup" />
                                                <MenuFlyoutItem Text="Dice Roll (1-6)"
                                                                Click="PresetItem_Click" Tag="Dice Roll (1-6)" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Clear All Options"
                                                                Command="{x:Bind ViewModel.ClearItemsCommand}" />
                                            </MenuFlyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                </StackPanel>
                            </controls:SectionCardControl.HeaderAction>

                            <controls:SectionCardControl.InnerContent>
                                <StackPanel Spacing="12">
                                    <!-- Quick Add New Option Row -->
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,8">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="78" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0"
                                                     PlaceholderText="Option name (Press Enter to add)..."
                                                     Text="{x:Bind ViewModel.NewItemText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     KeyDown="NewItemTextBox_KeyDown" />

                                            <NumberBox Grid.Column="1"
                                                       ToolTipService.ToolTip="Relative probability weight (default 1.0)"
                                                       Value="{x:Bind ViewModel.NewItemWeight, Mode=TwoWay}"
                                                       Minimum="0.1"
                                                       Maximum="50.0"
                                                       SmallChange="0.5"
                                                       SpinButtonPlacementMode="Compact" />

                                            <Button Grid.Column="2"
                                                    Style="{ThemeResource AccentButtonStyle}"
                                                    ToolTipService.ToolTip="Add Option Row"
                                                    Command="{x:Bind ViewModel.AddNewItemCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                                    <TextBlock Text="Add Row" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Table Column Header -->
                                    <Grid Padding="12,4" ColumnSpacing="8"
                                          Visibility="{x:Bind ViewModel.HasOptions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="68" />
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" Text="Option Label" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="Weight" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="3" Text="Odds" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="On" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                    </Grid>

                                    <!-- Items List Container -->
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            MinHeight="200"
                                            MaxHeight="340">
                                        <Grid>
                                            <controls:EmptyStateControl
                                                IconGlyph="&#xE735;"
                                                Title="No options on the wheel"
                                                Subtitle="Type an option above and press Enter, or click 'Presets' / 'Batch Add...' to populate rows."
                                                IsEmpty="{x:Bind ViewModel.IsOptionsEmpty, Mode=OneWay}" />

                                            <ListView ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                                                      SelectionMode="None"
                                                      Visibility="{x:Bind ViewModel.HasOptions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="lucky:WheelItemViewModel">
                                                        <Grid ColumnSpacing="8" Padding="2,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="22" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="68" />
                                                                <ColumnDefinition Width="46" />
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="28" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Color Swatch -->
                                                            <Border Grid.Column="0"
                                                                    Width="20" Height="20"
                                                                    CornerRadius="10"
                                                                    Background="{x:Bind Brush, Mode=OneWay}"
                                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                    BorderThickness="1"
                                                                    VerticalAlignment="Center" />

                                                            <!-- Text Editor -->
                                                            <TextBox Grid.Column="1"
                                                                     Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     VerticalAlignment="Center" />

                                                            <!-- Weight Box -->
                                                            <NumberBox Grid.Column="2"
                                                                       Value="{x:Bind Weight, Mode=TwoWay}"
                                                                       Minimum="0.1"
                                                                       Maximum="50.0"
                                                                       SmallChange="0.5"
                                                                       SpinButtonPlacementMode="Compact"
                                                                       VerticalAlignment="Center" />

                                                            <!-- Percentage Display -->
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{x:Bind PercentageText, Mode=OneWay}"
                                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Right" />

                                                            <!-- Enable / Disable Toggle -->
                                                            <CheckBox Grid.Column="4"
                                                                      IsChecked="{x:Bind IsEnabled, Mode=TwoWay}"
                                                                      MinWidth="0"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />

                                                            <!-- Delete Button -->
                                                            <Button Grid.Column="5"
                                                                    Padding="6,4"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Click="DeleteItemButton_Click"
                                                                    Tag="{x:Bind}"
                                                                    ToolTipService.ToolTip="Delete Option">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Grid>
                                    </Border>

                                    <!-- Bottom Summary Info & Batch Multi-Line Trigger -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Border Style="{StaticResource StatusBadgeBorderStyle}">
                                                <TextBlock Text="{x:Bind ViewModel.ActiveItemsText, Mode=OneWay}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" />
                                            </Border>
                                            <Border Style="{StaticResource StatusBadgeBorderStyle}">
                                                <TextBlock Text="{x:Bind ViewModel.TotalWeightText, Mode=OneWay}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" />
                                            </Border>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Content="Clear All"
                                                Padding="8,5"
                                                Command="{x:Bind ViewModel.ClearItemsCommand}"
                                                IsEnabled="{x:Bind ViewModel.IsNotSpinning, Mode=OneWay}" />

                                        <!-- Multi-Line Import Dialog Trigger -->
                                        <Button Grid.Column="2"
                                                Padding="10,5"
                                                Click="OpenImportDialogButton_Click"
                                                IsEnabled="{x:Bind ViewModel.IsNotSpinning, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8FD;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="Batch Add..." />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </controls:SectionCardControl.InnerContent>
                        </controls:SectionCardControl>
                    </StackPanel>
                </Grid>

                <!-- Status & Timing Footer -->
                <controls:StatusFooterControl
                    IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                    ProgressPercent="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                    StatusMessage="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    DurationText="{x:Bind ViewModel.LastDurationText, Mode=OneWay}"
                    CancelCommand="{x:Bind ViewModel.StopSpinCommand}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Celebratory Winner Modal / Dialog Overlay -->
        <Grid Background="#80000000"
              Visibility="{x:Bind ViewModel.IsResultModalOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Border Style="{StaticResource FluentCardBorderStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="440"
                    Padding="28"
                    CornerRadius="16"
                    BorderThickness="2"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
                <StackPanel Spacing="20" HorizontalAlignment="Stretch">
                    <!-- Header Icon & Title -->
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE735;" FontSize="36" Foreground="{ThemeResource SystemFillColorCautionBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="WE HAVE A WINNER!"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Winning Item Card Banner -->
                    <Border CornerRadius="12"
                            Background="{x:Bind ViewModel.WinningItem.Brush, Mode=OneWay}"
                            Padding="20,16"
                            HorizontalAlignment="Stretch">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.WinningItem.Text, Mode=OneWay}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{x:Bind ViewModel.WinningItem.ContrastForegroundBrush, Mode=OneWay}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.WinningProbabilityText, Mode=OneWay}"
                                       FontSize="13"
                                       Foreground="{x:Bind ViewModel.WinningItem.ContrastForegroundBrush, Mode=OneWay}"
                                       Opacity="0.85"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Height="40"
                                Command="{x:Bind ViewModel.StartSpinCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Text="Spin Again" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Height="40"
                                Command="{x:Bind ViewModel.RemoveWinnerCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                <TextBlock Text="Remove Winner" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.CopyWinnerToClipboardCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                <TextBlock Text="Copy Winner" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.CloseResultModalCommand}"
                                Content="Close" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Import Multi-Line Dialog Overlay -->
        <Grid Background="#80000000"
              Visibility="{x:Bind ViewModel.IsImportDialogOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Border Style="{StaticResource FluentCardBorderStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="480"
                    Padding="24"
                    CornerRadius="12">
                <StackPanel Spacing="16">
                    <TextBlock Text="Batch Add / Import Options"
                               Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Paste one option per line. Optionally append weight: 'Option Name: 2' or 'Option (3)'."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <TextBox Text="{x:Bind ViewModel.ImportPayloadText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MonospaceCodeTextBoxStyle}"
                             Height="180"
                             AcceptsReturn="True"
                             PlaceholderText="Option A&#x0a;Option B: 2.0&#x0a;Option C (3)" />

                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="CancelImportButton_Click" />
                        <Button Content="Import Rows"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.ExecuteImportCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
