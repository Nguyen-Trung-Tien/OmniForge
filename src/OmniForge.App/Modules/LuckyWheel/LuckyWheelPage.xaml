<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OmniForge.App.Modules.LuckyWheel.LuckyWheelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OmniForge.App.Controls"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:lucky="using:OmniForge.App.Modules.LuckyWheel">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveStates">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1020" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootScrollViewer.Padding" Value="{StaticResource OmniCompactPagePadding}" />
                        <Setter Target="WheelCol.Width" Value="*" />
                        <Setter Target="WheelCol.MinWidth" Value="0" />
                        <Setter Target="ConfigCol.Width" Value="*" />
                        <Setter Target="ConfigPanel.(Grid.Row)" Value="1" />
                        <Setter Target="ConfigPanel.(Grid.Column)" Value="0" />
                        <Setter Target="ConfigPanel.Margin" Value="0,16,0,0" />
                        <Setter Target="CanvasContainer.Height" Value="380" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Main Scrollable Content -->
        <ScrollViewer x:Name="RootScrollViewer" Style="{StaticResource PageScrollViewerStyle}">
            <StackPanel Style="{StaticResource PageRootStackPanelStyle}">
                <!-- Header Control -->
                <controls:ToolHeaderControl
                    Title="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Title]}"
                    Subtitle="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Subtitle]}"
                    HasError="{x:Bind ViewModel.HasError, Mode=TwoWay}"
                    ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=TwoWay}" />

                <!-- Main Layout Grid -->
                <Grid ColumnSpacing="20" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="WheelCol" Width="1*" MinWidth="340" MaxWidth="520" />
                        <ColumnDefinition x:Name="ConfigCol" Width="1.2*" MinWidth="380" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Wheel Canvas & Spin Controls -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="12">
                        <!-- Canvas Card Container -->
                        <Border Style="{StaticResource FluentCardBorderStyle}" Padding="10" CornerRadius="12">
                            <Grid x:Name="CanvasContainer" Height="390" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8">
                                <canvas:CanvasControl
                                    x:Name="WheelCanvas"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    ClearColor="Transparent"
                                    CreateResources="WheelCanvas_CreateResources"
                                    Draw="WheelCanvas_Draw"
                                    PointerPressed="WheelCanvas_PointerPressed" />
                            </Grid>
                        </Border>

                        <!-- Wheel Action Bar -->
                        <Border Style="{StaticResource FluentCardBorderStyle}" Padding="12">
                            <StackPanel Spacing="10">
                                <!-- Big Spin Action Button -->
                                <Button Style="{ThemeResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Height="44"
                                        Command="{x:Bind ViewModel.StartSpinCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanSpin, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE768;" FontSize="16" />
                                        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_SpinBtn]}" FontSize="15" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>

                                <!-- Secondary Wheel Controls Grid -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Duration Selector -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xED5A;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ComboBox SelectedIndex="1" SelectionChanged="DurationComboBox_SelectionChanged"
                                                  HorizontalAlignment="Stretch"
                                                  IsEnabled="{x:Bind ViewModel.IsNotSpinning, Mode=OneWay}">
                                            <ComboBoxItem Content="3.0s" Tag="3.0" />
                                            <ComboBoxItem Content="4.5s" Tag="4.5" />
                                            <ComboBoxItem Content="7.0s" Tag="7.0" />
                                            <ComboBoxItem Content="10.0s" Tag="10.0" />
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Physics Profile -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE777;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ComboBox SelectedIndex="0" Width="105" SelectionChanged="ProfileComboBox_SelectionChanged"
                                                  IsEnabled="{x:Bind ViewModel.IsNotSpinning, Mode=OneWay}">
                                            <ComboBoxItem Content="Ease-Out" />
                                            <ComboBoxItem Content="Expo" />
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Sound Toggle Button -->
                                    <ToggleButton Grid.Column="2"
                                                  IsChecked="{x:Bind ViewModel.IsSoundEnabled, Mode=TwoWay}"
                                                  ToolTipService.ToolTip="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Sound]}"
                                                  Padding="8,5">
                                        <FontIcon Glyph="&#xE767;" FontSize="13" />
                                    </ToggleButton>

                                    <!-- Winner History Flyout Button -->
                                    <Button Grid.Column="3"
                                            Padding="8,5"
                                            ToolTipService.ToolTip="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_History_Title]}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE81C;" FontSize="12" />
                                            <TextBlock Text="{x:Bind ViewModel.HistoryButtonText, Mode=OneWay}" FontSize="12" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedRight">
                                                <Grid Width="340" MaxHeight="380" RowSpacing="10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_History_Title]}" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                                        <Button Grid.Column="1" Content="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_History_Clear]}" Padding="6,2" FontSize="11" Command="{x:Bind ViewModel.ClearHistoryCommand}" />
                                                    </Grid>

                                                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.History, Mode=OneWay}" SelectionMode="None">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate x:DataType="lucky:WinnerHistoryEntryViewModel">
                                                                <Grid ColumnSpacing="8" Padding="0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="16" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Width="14" Height="14" CornerRadius="7" Background="{x:Bind Brush, Mode=OneWay}" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" />
                                                                    <TextBlock Grid.Column="2" Text="{x:Bind FormattedOdds, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="6,0" />
                                                                    <TextBlock Grid.Column="3" Text="{x:Bind FormattedTime, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>

                                                    <Button Grid.Row="2" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.CopyHistoryCommand}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                            <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                                            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_History_CopyAll]}" FontSize="12" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Column: Configuration & Items Panel -->
                    <StackPanel x:Name="ConfigPanel" Grid.Row="0" Grid.Column="1" Spacing="14">
                        <controls:SectionCardControl
                            Title="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_ItemsListTitle]}"
                            Subtitle="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_ItemsListSubtitle]}"
                            IconGlyph="&#xE8FD;">
                            <controls:SectionCardControl.InnerContent>
                                <StackPanel Spacing="12">
                                    <!-- Action Command Bar: Import, Presets, Actions -->
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,6">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Smart File & Batch Import Button -->
                                            <Button Grid.Column="0"
                                                    Style="{ThemeResource AccentButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    ToolTipService.ToolTip="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_ImportFileToolTip]}"
                                                    Padding="10,5"
                                                    Command="{x:Bind ViewModel.OpenImportModalCommand}"
                                                    IsEnabled="{x:Bind ViewModel.IsNotSpinning, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                    <FontIcon Glyph="&#xE8FD;" FontSize="13" />
                                                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_ImportFileBtn]}" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Presets Flyout Button -->
                                            <DropDownButton Grid.Column="1"
                                                            Padding="10,5"
                                                            FontSize="12"
                                                            IsEnabled="{x:Bind ViewModel.IsNotSpinning, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE71D;" FontSize="12" />
                                                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Presets]}" />
                                                </StackPanel>
                                                <DropDownButton.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                        <MenuFlyoutItem Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Preset_Decision]}"
                                                                        Click="PresetItem_Click" Tag="Decision Maker">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE8AB;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Preset_Lunch]}"
                                                                        Click="PresetItem_Click" Tag="Lunch Chooser">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xEC32;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Preset_Raffle]}"
                                                                        Click="PresetItem_Click" Tag="Prize Raffle">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE735;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Preset_Standup]}"
                                                                        Click="PresetItem_Click" Tag="Team Standup">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE716;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Preset_Dice]}"
                                                                        Click="PresetItem_Click" Tag="Dice Roll (1-6)">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE734;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </DropDownButton.Flyout>
                                            </DropDownButton>

                                            <!-- Actions Dropdown Button -->
                                            <DropDownButton Grid.Column="2"
                                                            Padding="10,5"
                                                            FontSize="12"
                                                            IsEnabled="{x:Bind ViewModel.IsNotSpinning, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE712;" FontSize="12" />
                                                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Actions]}" />
                                                </StackPanel>
                                                <DropDownButton.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                        <MenuFlyoutItem Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Action_SortName]}"
                                                                        Command="{x:Bind ViewModel.SortByNameCommand}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE8CB;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Action_SortWeight]}"
                                                                        Command="{x:Bind ViewModel.SortByWeightCommand}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE8EB;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Action_Shuffle]}"
                                                                        Command="{x:Bind ViewModel.ShuffleItemsCommand}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE8B1;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Action_Equalize]}"
                                                                        Command="{x:Bind ViewModel.EqualizeWeightsCommand}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE8EF;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Action_EnableAll]}"
                                                                        Command="{x:Bind ViewModel.EnableAllItemsCommand}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE73A;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Action_DisableAll]}"
                                                                        Command="{x:Bind ViewModel.DisableAllItemsCommand}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE739;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Action_CopyCsv]}"
                                                                        Command="{x:Bind ViewModel.ExportToClipboardCommand}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE8C8;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Action_ClearAll]}"
                                                                        Command="{x:Bind ViewModel.ClearItemsCommand}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </DropDownButton.Flyout>
                                            </DropDownButton>
                                        </Grid>
                                    </Border>
                                    <!-- Quick Multi-Add New Option Bar -->
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,6">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0"
                                                     PlaceholderText="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_QuickAdd_Placeholder]}"
                                                     Text="{x:Bind ViewModel.NewItemText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     KeyDown="NewItemTextBox_KeyDown" />

                                            <Button Grid.Column="1"
                                                    Style="{ThemeResource AccentButtonStyle}"
                                                    ToolTipService.ToolTip="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_QuickAdd_AddToolTip]}"
                                                    Command="{x:Bind ViewModel.AddNewItemCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_QuickAdd_AddBtn]}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Search & Realtime Metrics Bar -->
                                    <StackPanel Spacing="8">
                                        <!-- Filter Search Box with Icon Header -->
                                        <TextBox PlaceholderText="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Filter_Placeholder]}"
                                                 Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.Header>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE721;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Filter_Header]}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </TextBox.Header>
                                        </TextBox>

                                        <!-- Metric Badges Strip -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Style="{StaticResource StatusBadgeBorderStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE8FD;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind ViewModel.ItemsCountSummaryText, Mode=OneWay}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource StatusBadgeBorderStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                    <TextBlock Text="{x:Bind ViewModel.ActiveItemsText, Mode=OneWay}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource StatusBadgeBorderStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE8EC;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind ViewModel.TotalWeightText, Mode=OneWay}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Table Column Header -->
                                    <Grid Padding="12,4" ColumnSpacing="8"
                                          Visibility="{x:Bind ViewModel.HasOptions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xEB9F;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" ToolTipService.ToolTip="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Col_Color]}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE8D2;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Col_Name]}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE8EC;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Col_Weight]}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                            <FontIcon Glyph="&#xE9D9;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Col_Odds]}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="4" Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" ToolTipService.ToolTip="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Col_Toggle]}" />
                                        <FontIcon Grid.Column="5" Glyph="&#xE74D;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" ToolTipService.ToolTip="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Col_Delete]}" />
                                    </Grid>

                                    <!-- Items List Container -->
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            MinHeight="220"
                                            MaxHeight="360">
                                        <Grid>
                                            <controls:EmptyStateControl
                                                IconGlyph="&#xE735;"
                                                Title="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Empty_Title]}"
                                                Subtitle="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Empty_Subtitle]}"
                                                IsEmpty="{x:Bind ViewModel.IsOptionsEmpty, Mode=OneWay}" />

                                            <ListView ItemsSource="{x:Bind ViewModel.FilteredItems, Mode=OneWay}"
                                                      SelectionMode="None"
                                                      Visibility="{x:Bind ViewModel.HasOptions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="lucky:WheelItemViewModel">
                                                        <Grid ColumnSpacing="8" Padding="2,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="22" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="96" />
                                                                <ColumnDefinition Width="56" />
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="28" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Color Swatch -->
                                                            <Border Grid.Column="0"
                                                                    Width="20" Height="20"
                                                                    CornerRadius="10"
                                                                    Background="{x:Bind Brush, Mode=OneWay}"
                                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                    BorderThickness="1"
                                                                    VerticalAlignment="Center" />

                                                            <!-- Text Editor -->
                                                            <TextBox Grid.Column="1"
                                                                     Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     ToolTipService.ToolTip="{x:Bind Text, Mode=OneWay}"
                                                                     TextWrapping="NoWrap"
                                                                     VerticalAlignment="Center" />

                                                            <!-- Weight Stepper: [-] [ 1.0 ] [+] -->
                                                            <Border Grid.Column="2"
                                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Height="30"
                                                                    VerticalAlignment="Center">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="26" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="26" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <Button Grid.Column="0"
                                                                            Padding="0"
                                                                            Width="26" Height="28"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            Command="{x:Bind DecreaseWeightCommand}"
                                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Stepper_Decrease]}">
                                                                        <FontIcon Glyph="&#xE738;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                    </Button>

                                                                    <TextBox Grid.Column="1"
                                                                             Text="{x:Bind WeightText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                             KeyDown="WeightTextBox_KeyDown"
                                                                             TextAlignment="Center"
                                                                             VerticalAlignment="Center"
                                                                             Padding="0"
                                                                             Height="26"
                                                                             MinWidth="0"
                                                                             FontSize="12"
                                                                             FontWeight="SemiBold"
                                                                             Background="Transparent"
                                                                             BorderThickness="0"
                                                                             ToolTipService.ToolTip="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Stepper_Tip]}" />

                                                                    <Button Grid.Column="2"
                                                                            Padding="0"
                                                                            Width="26" Height="28"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            Command="{x:Bind IncreaseWeightCommand}"
                                                                            ToolTipService.ToolTip="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Stepper_Increase]}">
                                                                        <FontIcon Glyph="&#xE710;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                    </Button>
                                                                </Grid>
                                                            </Border>

                                                            <!-- Percentage Display -->
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{x:Bind PercentageText, Mode=OneWay}"
                                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Right" />

                                                            <!-- Enable / Disable Toggle -->
                                                            <CheckBox Grid.Column="4"
                                                                      IsChecked="{x:Bind IsEnabled, Mode=TwoWay}"
                                                                      MinWidth="0"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />

                                                            <!-- Delete Button -->
                                                            <Button Grid.Column="5"
                                                                    Padding="6,4"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Click="DeleteItemButton_Click"
                                                                    Tag="{x:Bind}"
                                                                    ToolTipService.ToolTip="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Col_Delete]}">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </controls:SectionCardControl.InnerContent>
                        </controls:SectionCardControl>
                    </StackPanel>
                </Grid>

                <!-- Status & Timing Footer -->
                <controls:StatusFooterControl
                    IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                    ProgressPercent="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                    StatusMessage="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    DurationText="{x:Bind ViewModel.LastDurationText, Mode=OneWay}"
                    CancelCommand="{x:Bind ViewModel.StopSpinCommand}" />
            </StackPanel>
        </ScrollViewer>

        <!-- ========================================================================= -->
        <!-- POPUP 1: CELEBRATORY WINNER MODAL DIALOG                                   -->
        <!-- ========================================================================= -->
        <Grid Background="{ThemeResource SmokeFillColorDefaultBrush}"
              Visibility="{x:Bind ViewModel.IsResultModalOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Border Style="{StaticResource FluentDialogBorderStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="480"
                    Padding="28"
                    CornerRadius="16"
                    BorderThickness="2"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
                <StackPanel Spacing="20" HorizontalAlignment="Stretch">
                    <!-- Header Trophy Icon & Title -->
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE735;" FontSize="40" Foreground="{ThemeResource SystemFillColorCautionBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Winner_Title]}"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Winning Item Card Banner -->
                    <Border CornerRadius="12"
                            Background="{x:Bind ViewModel.WinningItem.Brush, Mode=OneWay}"
                            Padding="22,18"
                            HorizontalAlignment="Stretch">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.WinningItem.Text, Mode=OneWay}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{x:Bind ViewModel.WinningItem.ContrastForegroundBrush, Mode=OneWay}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxHeight="120"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.WinningItem.Text, Mode=OneWay}"
                                       TextAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.WinningProbabilityText, Mode=OneWay}"
                                           FontSize="13"
                                           Foreground="{x:Bind ViewModel.WinningItem.ContrastForegroundBrush, Mode=OneWay}"
                                           Opacity="0.9" />
                                <TextBlock Text="•"
                                           FontSize="13"
                                           Foreground="{x:Bind ViewModel.WinningItem.ContrastForegroundBrush, Mode=OneWay}"
                                           Opacity="0.7" />
                                <TextBlock Text="{x:Bind ViewModel.WinningTimestampText, Mode=OneWay}"
                                           FontSize="13"
                                           Foreground="{x:Bind ViewModel.WinningItem.ContrastForegroundBrush, Mode=OneWay}"
                                           Opacity="0.9" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Primary Actions: Spin Again & Remove Winner -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Height="42"
                                Command="{x:Bind ViewModel.SpinAgainCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Winner_SpinAgain]}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Height="42"
                                ToolTipService.ToolTip="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Winner_RemoveTip]}"
                                Command="{x:Bind ViewModel.RemoveWinnerAndSpinCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Winner_RemoveAndSpin]}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Secondary Actions: Copy & Close -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.CopyWinnerToClipboardCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Winner_CopyName]}" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.CloseResultModalCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE711;" FontSize="13" />
                                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Winner_Close]}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- POPUP 2: SMART IMPORT MODAL (EXCEL .XLSX, CSV, TXT & BATCH PASTE)          -->
        <!-- ========================================================================= -->
        <Grid Background="{ThemeResource SmokeFillColorDefaultBrush}"
              Visibility="{x:Bind ViewModel.IsImportModalOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Border Style="{StaticResource FluentDialogBorderStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="580"
                    Padding="28"
                    CornerRadius="14">
                <StackPanel Spacing="16">
                    <!-- Title & Subtitle -->
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8FD;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Import_Title]}"
                                       Style="{ThemeResource SubtitleTextBlockStyle}"
                                       FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Import_Subtitle]}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Segmented Tabs for Import Source -->
                    <Pivot SelectedIndex="{x:Bind ViewModel.ImportTabIndex, Mode=TwoWay}">
                        <!-- Tab 1: File Import -->
                        <PivotItem>
                            <PivotItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="13" />
                                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Import_TabFile]}" />
                                </StackPanel>
                            </PivotItem.Header>
                            <StackPanel Spacing="12" Margin="0,10,0,0">
                                <!-- File Selector Card -->
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="18">
                                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE8E5;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.ImportFileStatusText, Mode=OneWay}"
                                                   Style="{ThemeResource BodyTextBlockStyle}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <Button Style="{ThemeResource AccentButtonStyle}"
                                                HorizontalAlignment="Center"
                                                Command="{x:Bind ViewModel.PickImportFileCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE838;" FontSize="14" />
                                                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Import_ChooseFile]}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Parsed Items Preview -->
                                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasImportPreview, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{x:Bind ViewModel.ImportPreviewSummary, Mode=OneWay}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />

                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            MaxHeight="140">
                                        <ListView ItemsSource="{x:Bind ViewModel.ImportPreviewItems, Mode=OneWay}" SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="lucky:WheelItemViewModel">
                                                    <Grid ColumnSpacing="8" Padding="2,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="16" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="14" Height="14" CornerRadius="7" Background="{x:Bind Brush, Mode=OneWay}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Text, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Text, Mode=OneWay}" />
                                                        <TextBlock Grid.Column="2" Text="{x:Bind Weight, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </PivotItem>

                        <!-- Tab 2: Raw Text Paste -->
                        <PivotItem>
                            <PivotItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Import_TabPaste]}" />
                                </StackPanel>
                            </PivotItem.Header>
                            <StackPanel Spacing="8" Margin="0,10,0,0">
                                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Import_PasteTip]}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <TextBox Text="{x:Bind ViewModel.ImportPayloadText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MonospaceCodeTextBoxStyle}"
                                         Background="{ThemeResource LayerFillColorDefaultBrush}"
                                         Height="160"
                                         AcceptsReturn="True"
                                         PlaceholderText="Nguyễn Văn A&#x0a;Trần Thị B: 2.5&#x0a;Lê Văn C (1.5)&#x0a;Phạm Văn D, 3.0" />
                            </StackPanel>
                        </PivotItem>
                    </Pivot>

                    <!-- Import Mode: Replace vs Append -->
                    <StackPanel Spacing="6" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Import_Mode]}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton IsChecked="{x:Bind ViewModel.IsReplaceMode, Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Import_Replace]}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton IsChecked="{x:Bind ViewModel.IsAppendMode, Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Import_Append]}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Command="{x:Bind ViewModel.CloseImportModalCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Import_Cancel]}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.ExecuteImportCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE73E;" FontSize="13" />
                                <TextBlock Text="{Binding Source={StaticResource Loc}, Path=[LuckyWheel_Import_Confirm]}" FontWeight="SemiBold" />
                            </StackPanel>
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Enter" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
