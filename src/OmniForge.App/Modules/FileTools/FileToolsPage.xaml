<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OmniForge.App.Modules.FileTools.FileToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:OmniForge.App.Controls"
    xmlns:local="using:OmniForge.App.Modules.FileTools"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" RowSpacing="12" Padding="{StaticResource OmniPagePadding}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveStates">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="980" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootGrid.Padding" Value="{StaticResource OmniCompactPagePadding}" />
                        <Setter Target="TargetButtonsRow.Height" Value="Auto" />
                        <Setter Target="TargetActionsCol.Width" Value="0" />
                        <Setter Target="TargetActionsPanel.(Grid.Row)" Value="1" />
                        <Setter Target="TargetActionsPanel.(Grid.Column)" Value="0" />
                        <Setter Target="FilterCol0.Width" Value="*" />
                        <Setter Target="FilterStatusPanel.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:ToolHeaderControl
            Grid.Row="0"
            Title="{Binding Source={StaticResource Loc}, Path=[FileTools_Title]}"
            Subtitle="{Binding Source={StaticResource Loc}, Path=[FileTools_Subtitle]}"
            HasError="{x:Bind ViewModel.HasError, Mode=TwoWay}"
            ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=TwoWay}" />

        <!-- Target Directory & Filter Bar -->
        <Border Grid.Row="1" Style="{StaticResource FluentCardBorderStyle}" Padding="16,12">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="TargetDirectoryGrid" Grid.Row="0" ColumnSpacing="8" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="TargetButtonsRow" Height="0" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="TargetPathCol" Width="*" />
                        <ColumnDefinition x:Name="TargetActionsCol" Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TargetDirectoryBox"
                             Grid.Row="0" Grid.Column="0"
                             Text="{x:Bind ViewModel.TargetDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Enter folder path to scan..." />

                    <StackPanel x:Name="TargetActionsPanel"
                                Grid.Row="0" Grid.Column="1"
                                Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Content="Browse..."
                                Command="{x:Bind ViewModel.BrowseFolderCommand}" />

                        <Button ToolTipService.ToolTip="Copy path to clipboard"
                                Command="{x:Bind ViewModel.CopyTargetPathCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                <TextBlock Text="Copy Path" />
                            </StackPanel>
                        </Button>

                        <Button ToolTipService.ToolTip="Open folder in Windows Explorer"
                                Command="{x:Bind ViewModel.OpenInExplorerCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8DA;" FontSize="13" />
                                <TextBlock Text="Explorer" />
                            </StackPanel>
                        </Button>

                        <Button Command="{x:Bind ViewModel.ScanDirectoryCommand}"
                                Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE721;" FontSize="13" />
                                <TextBlock Text="Scan Files" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="FilterCol0" Width="320" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             PlaceholderText="Filter by filename or extension (e.g. .pdf, .json)..."
                             Text="{x:Bind ViewModel.SearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Grid.Column="1"
                              Content="Include Subfolders"
                              MinWidth="0"
                              IsChecked="{x:Bind ViewModel.IncludeSubfolders, Mode=TwoWay}"
                              VerticalAlignment="Center" />

                    <StackPanel x:Name="FilterStatusPanel" Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Style="{StaticResource StatusBadgeBorderStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Files:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                <TextBlock Text="{x:Bind ViewModel.TotalScannedCount, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatusBadgeBorderStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Total Size:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                <TextBlock Text="{x:Bind ViewModel.FormattedDirectorySize, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Discovered Files Table Card -->
        <Border Grid.Row="2" Style="{StaticResource FluentCardBorderStyle}" Padding="14">
            <Grid>
                <controls:EmptyStateControl
                    IconGlyph="&#xE8B7;"
                    Title="No files to display"
                    Subtitle="Click 'Scan Files' or 'Browse...' above to inspect directory contents."
                    IsEmpty="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

                <Grid Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Table Header -->
                    <Grid Grid.Row="0"
                          Padding="12,8"
                          Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                          CornerRadius="4"
                          Margin="0,0,0,6"
                          ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="85" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="95" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="" />
                        <TextBlock Grid.Column="1" Text="File Name" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Type" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Last Modified" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="Size" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" TextAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="Actions" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" TextAlignment="Right" />
                    </Grid>

                    <!-- Virtualized File Rows -->
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.DiscoveredFileItems, Mode=OneWay}"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:FileItemDisplayModel">
                                <Grid Padding="0,6" ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind FullPath, Mode=OneTime}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="85" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0"
                                              Glyph="&#xE8A5;"
                                              FontSize="14"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind FileName, Mode=OneTime}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <Border Grid.Column="2"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Extension, Mode=OneTime}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>

                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind ModifiedText, Mode=OneTime}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="4"
                                               Text="{x:Bind FormattedSize, Mode=OneTime}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center" />

                                    <!-- Quick Per-File Actions -->
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Padding="6,4"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Tag="{x:Bind}"
                                                Click="CopyFilePathButton_Click"
                                                ToolTipService.ToolTip="Copy full file path">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Button>
                                        <Button Padding="6,4"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Tag="{x:Bind}"
                                                Click="RevealFileButton_Click"
                                                ToolTipService.ToolTip="Reveal in Windows Explorer">
                                            <FontIcon Glyph="&#xE8DA;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Border>

        <!-- Bottom Status Footer -->
        <controls:StatusFooterControl
            Grid.Row="3"
            IsBusy="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
            IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
            ProgressPercent="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
            StatusMessage="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            DurationText="{x:Bind ViewModel.LastDurationText, Mode=OneWay}" />
    </Grid>
</Page>
