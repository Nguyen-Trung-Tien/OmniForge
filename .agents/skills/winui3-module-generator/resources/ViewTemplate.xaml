<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OmniForge.App.Modules.__MODULE_NAME__.__MODULE_NAME__Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:OmniForge.App.Controls"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,24">
        <StackPanel Spacing="20" MaxWidth="800" HorizontalAlignment="Left">
            <controls:ToolHeaderControl
                Title="__DISPLAY_NAME__"
                Subtitle="__DESCRIPTION__"
                HasError="{x:Bind ViewModel.HasError, Mode=OneWay}"
                ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

            <TextBox Header="Input"
                     PlaceholderText="Provide payload or path here..."
                     Text="{x:Bind ViewModel.InputData, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Execute"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.ExecuteCommand}" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              Width="20" Height="20" />
            </StackPanel>

            <TextBox Header="Output Result"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     MinHeight="140"
                     Text="{x:Bind ViewModel.OutputData, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
