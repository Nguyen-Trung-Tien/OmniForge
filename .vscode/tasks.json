{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "forge: verify (Arch + Build + Test)",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/forge.ps1", "verify"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "forge: build (Debug x64)",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/forge.ps1", "build"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "forge: run (Launch WinUI 3 App)",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/forge.ps1", "run"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "forge: arch (Fast Static Check)",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/forge.ps1", "arch"]
    },
    {
      "label": "forge: doctor (Environment Check)",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/forge.ps1", "doctor"]
    }
  ]
}

