<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <RunCommand>dotnet</RunCommand>
    <RunArguments>run --project &quot;$(MSBuildThisFileDirectory)src\OmniForge.App\OmniForge.App.csproj&quot; --launch-profile &quot;OmniForge.App (Unpackaged)&quot; -p:WindowsPackageType=None -p:Platform=x64</RunArguments>
    <RunWorkingDirectory>$(MSBuildThisFileDirectory)src\OmniForge.App</RunWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Launcher.cs" />
  </ItemGroup>
</Project>
